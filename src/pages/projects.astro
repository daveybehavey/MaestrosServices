---
import Layout from "../components/Layout.astro";
import { business } from "../data/business";
import { projectProfiles } from "../data/projects";
import { gutterPhotos, pathPhotos } from "../data/workPhotos";
import { createBreadcrumbSchema } from "../lib/schema";

const pageTitle = "Recent Property Work | Maestros Services";
const metaDescription =
  "See real Maestros job photos of a stepping-stone path, roof moss and gutter work, then send your own project details to request a quote.";
const canonicalUrl = `${business.siteUrl}${Astro.url.pathname}`;
const structuredData = [
  createBreadcrumbSchema([{ name: "Projects", href: "/projects" }]),
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Landscaping project scopes",
    itemListElement: projectProfiles.map((project, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: project.title,
      description: project.summary,
    })),
  },
];
---

<Layout
  title={pageTitle}
  description={metaDescription}
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
  ogImage={`${business.siteUrl}/work/path-after-dog.jpg`}
  quoteHref="/quote"
  showDesktopCTA={false}
  analytics={{ pageGroup: "projects", pageType: "list", pageTemplate: "projects" }}
>
  <section class="section">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="max-w-3xl space-y-5">
        <p class="section-kicker">Recent work</p>
        <h1 class="section-title">See the work behind the result.</h1>
        <p class="section-copy">
          A garden path taking shape, stones laid by hand, and a closer look at roof and gutter work.
          These photos come from our jobs in November 2026.
        </p>
        <div class="flex flex-wrap gap-3">
          <a class="btn-primary inline-flex min-h-11 items-center px-6 py-3" href="/quote" data-ga-event="cta_click" data-ga-label="projects_intro_quote">Tell us about your project</a>
          <a class="btn-secondary inline-flex min-h-11 items-center px-6 py-3" href="/stepping-stone-paths">Explore the path project</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="path-work-title">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-5 sm:mb-8">
        <div class="max-w-2xl space-y-3">
          <p class="section-kicker">From start to finish</p>
          <h2 id="path-work-title" class="section-title">A new path through the garden.</h2>
          <p class="section-copy">Follow one project from the original track to the finished stepping stones.</p>
        </div>
        <a class="inline-flex min-h-11 items-center text-sm font-semibold text-ink underline underline-offset-4" href="/stepping-stone-paths" data-ga-event="cta_click" data-ga-label="projects_path_story">See the full project <span aria-hidden="true" class="ml-2">→</span></a>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {pathPhotos.map((photo) => (
          <figure class="overflow-hidden rounded-2xl border border-border bg-white/90 shadow-fine">
            <a class="block aspect-[4/3] bg-paper" href={photo.src} target="_blank" rel="noreferrer" aria-label={`Open full photo: ${photo.alt}`}>
              <img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} class="h-full w-full object-contain" loading="lazy" decoding="async" />
            </a>
            <figcaption class="border-t border-border px-5 py-4 text-sm leading-6 text-ink-soft">{photo.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="gutter-work-title">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="mb-6 max-w-2xl space-y-3 sm:mb-8">
        <p class="section-kicker">Roof and gutter work</p>
        <h2 id="gutter-work-title" class="section-title">A closer look at the buildup.</h2>
        <p class="section-copy">Leaves and needles in a gutter, moss on the roof, and debris collected during the job.</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {gutterPhotos.map((photo) => (
          <figure class="overflow-hidden rounded-2xl border border-border bg-white/90 shadow-fine">
            <a class="block aspect-[4/3] bg-paper" href={photo.src} target="_blank" rel="noreferrer" aria-label={`Open full photo: ${photo.alt}`}>
              <img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} class="h-full w-full object-contain" loading="lazy" decoding="async" />
            </a>
            <figcaption class="border-t border-border px-5 py-4 text-sm leading-6 text-ink-soft">{photo.caption}</figcaption>
          </figure>
        ))}
      </div>
      <a class="mt-5 inline-flex min-h-11 items-center text-sm font-semibold text-ink underline underline-offset-4" href="/services/gutter-cleaning">See our gutter-cleaning service <span aria-hidden="true" class="ml-2">→</span></a>
    </div>
  </section>

  <section class="section pt-0" aria-labelledby="project-scopes-title">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="mb-6 max-w-2xl space-y-3 sm:mb-8">
        <p class="section-kicker">Planning your own project?</p>
        <h2 id="project-scopes-title" class="section-title">Other work we can help with.</h2>
        <p class="section-copy">Explore these example scopes, then tell us what your property needs. We will confirm the work and availability with you.</p>
      </div>
      <div class="grid gap-5 lg:grid-cols-2">
        {projectProfiles.map((project) => (
          <article class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine">
            <h3 class="text-2xl font-display">{project.title}</h3>
            <p class="mt-2 text-sm leading-6 text-ink-soft">{project.summary}</p>
            <div class="mt-5 rounded-xl border border-border bg-paper/50 p-4">
              <p class="text-xs uppercase tracking-[0.2em] text-ink-soft">Ideal for</p>
              <p class="mt-2 text-sm leading-6 text-ink">{project.idealFor}</p>
            </div>
            <p class="mt-5 text-xs uppercase tracking-[0.2em] text-ink-soft">Possible scope</p>
            <ul class="mt-3 space-y-2 text-sm leading-6 text-ink-soft">
              {project.scope.map((item) => <li class="flex gap-3"><span aria-hidden="true" class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-ink/70"></span>{item}</li>)}
            </ul>
            <div class="mt-5 flex flex-wrap gap-2">
              {project.relatedServiceHrefs.map((service) => (
                <a class="inline-flex min-h-11 items-center rounded-full border border-border bg-white px-4 py-2 text-xs font-semibold text-ink-soft hover:border-ink hover:text-ink" href={service.href}>{service.label}</a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section pt-0">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="spotlight-band rounded-[2rem] border border-border px-6 py-10 text-paper shadow-soft sm:px-10">
        <p class="section-kicker text-paper/70">Your project starts here</p>
        <h2 class="mt-2 text-3xl font-display text-paper sm:text-4xl">Tell us what you have in mind.</h2>
        <p class="mt-3 max-w-2xl text-sm leading-7 text-paper/90 sm:text-base">Send photos of the area, your town, and the work you need. We will confirm the scope, availability, and next step.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a class="inline-flex min-h-11 items-center rounded-full bg-paper px-6 py-3 text-sm font-semibold text-ink hover:bg-paper/90" href={business.smsHref} data-ga-event="cta_click" data-ga-label="projects_text_photos">Text photos for a quote</a>
          <a class="inline-flex min-h-11 items-center rounded-full border border-paper/40 px-6 py-3 text-sm font-semibold text-paper hover:border-paper" href="/quote" data-ga-event="cta_click" data-ga-label="projects_quote">Request a quote online</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
