---
import Layout from "../../components/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getCollection } from "astro:content";
import { business } from "../../data/business";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const pageTitle = `Lawn Care Tips, Landscaping Advice & Seasonal Guides | ${business.name}`;
const pageDescription =
  "Seasonal lawn care tips, landscaping advice, and garden maintenance guides for Vancouver Island homeowners. Learn how to keep your yard looking great year-round.";
const canonicalUrl = `${business.siteUrl}/blog`;

const breadcrumbItems = [{ name: "Blog", href: "/blog" }];

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-CA", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
}
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  headerVariant="simple"
  headerSubtitle="Blog"
  quoteHref="/quote"
>
  <section class="section">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <Breadcrumbs items={breadcrumbItems} />

      <div class="mb-10 space-y-4">
        <p class="section-kicker">Tips & Guides</p>
        <h1 class="section-title">Lawn Care and Landscaping Blog</h1>
        <p class="max-w-3xl text-base text-ink-soft">
          Expert advice for Vancouver Island homeowners. Learn seasonal maintenance tips,
          best practices for lawn care, and how to keep your outdoor spaces looking their
          best year-round.
        </p>
      </div>

      <div class="mb-10 grid gap-4 rounded-2xl border border-border bg-white/90 p-6 shadow-fine sm:grid-cols-3">
        <a class="rounded-xl border border-border bg-paper/50 p-4 transition hover:border-ink/30" href="/services">
          <p class="text-sm font-semibold text-ink">Browse services</p>
          <p class="mt-1 text-sm text-ink-soft">See the core jobs homeowners ask for most.</p>
        </a>
        <a class="rounded-xl border border-border bg-paper/50 p-4 transition hover:border-ink/30" href="/service-area">
          <p class="text-sm font-semibold text-ink">Check service area</p>
          <p class="mt-1 text-sm text-ink-soft">Confirm coverage before you request a quote.</p>
        </a>
        <a class="rounded-xl border border-border bg-paper/50 p-4 transition hover:border-ink/30" href="/quote">
          <p class="text-sm font-semibold text-ink">Request a quote</p>
          <p class="mt-1 text-sm text-ink-soft">Send details and get a fast residential response.</p>
        </a>
      </div>

      {
        posts.length === 0 ? (
          <div class="rounded-2xl border border-border bg-white/90 p-8 text-center shadow-fine">
            <p class="text-lg font-semibold text-ink">Coming soon</p>
            <p class="mt-2 text-sm text-ink-soft">
              We're working on helpful articles about lawn care and landscaping on Vancouver
              Island. Check back soon!
            </p>
          </div>
        ) : (
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {posts.map((post, index) => (
              <a
                href={`/blog/${post.slug}`}
                class="group flex flex-col rounded-2xl border border-border bg-white/90 shadow-fine transition hover:border-ink/30 animate-rise"
                style={`animation-delay: ${index * 60}ms`}
              >
                {post.data.image && (
                  <div class="aspect-[16/10] overflow-hidden rounded-t-2xl bg-paper/80">
                    <img
                      src={post.data.image}
                      alt={post.data.imageAlt || post.data.title}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                      decoding="async"
                      sizes="(min-width: 1024px) 30vw, (min-width: 768px) 46vw, 100vw"
                    />
                  </div>
                )}
                <div class="flex flex-1 flex-col p-6">
                  <div class="mb-2 flex flex-wrap gap-2">
                    {post.data.tags.slice(0, 2).map((tag) => (
                      <span class="rounded-full border border-border bg-paper px-2 py-0.5 text-[0.65rem] uppercase tracking-wider text-ink-soft">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <h2 class="mb-2 text-lg font-semibold text-ink group-hover:text-ink/80">
                    {post.data.title}
                  </h2>
                  <p class="mb-4 flex-1 text-sm leading-relaxed text-ink-soft">
                    {post.data.description}
                  </p>
                  <p class="text-xs text-ink-soft">{formatDate(post.data.pubDate)}</p>
                </div>
              </a>
            ))}
          </div>
        )
      }

      <div class="mt-10 rounded-2xl border border-border bg-white/90 p-6 shadow-fine sm:p-8">
        <p class="section-kicker">Start here</p>
        <h2 class="mb-3 text-2xl font-display font-semibold text-ink">Best pages for traffic and leads</h2>
        <div class="flex flex-wrap gap-3 text-sm">
          <a class="rounded-full border border-border bg-paper px-4 py-2 text-ink-soft transition hover:border-ink/30 hover:text-ink" href="/services">
            Services
          </a>
          <a class="rounded-full border border-border bg-paper px-4 py-2 text-ink-soft transition hover:border-ink/30 hover:text-ink" href="/service-area">
            Service area
          </a>
          <a class="rounded-full border border-border bg-paper px-4 py-2 text-ink-soft transition hover:border-ink/30 hover:text-ink" href="/quote">
            Quote
          </a>
          <a class="rounded-full border border-border bg-paper px-4 py-2 text-ink-soft transition hover:border-ink/30 hover:text-ink" href="/blog/how-often-should-you-mow-your-lawn-vancouver-island">
            Mowing guide
          </a>
          <a class="rounded-full border border-border bg-paper px-4 py-2 text-ink-soft transition hover:border-ink/30 hover:text-ink" href="/blog/when-should-you-trim-hedges-vancouver-island">
            Hedge trimming guide
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
