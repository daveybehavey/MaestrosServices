---
import Layout from "../components/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { business } from "../data/business";
import { createBreadcrumbSchema, createOrganizationSchema } from "../lib/schema";

const pageTitle = `Leave a Review | ${business.name}`;
const pageDescription =
  "Share your experience with Maestros Services in a quick Google review. Honest feedback, good or bad, helps local homeowners know what to expect.";
const canonicalUrl = `${business.siteUrl}/review`;
const breadcrumbItems = [{ name: "Leave a review", href: "/review" }];

const reviewNotes = [
  "Reviews are public on Google, and they help other homeowners know what to expect when they hire us.",
  "We read every review. Honest feedback, good or bad, shows us what to keep doing and what to do better.",
];

const structuredData = [createOrganizationSchema(), createBreadcrumbSchema(breadcrumbItems)];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
  headerVariant="simple"
  headerSubtitle="Share your experience"
  quoteHref="/quote"
  analytics={{
    pageGroup: "review",
    pageType: "review_request",
    pageTemplate: "review",
  }}
>
  <section class="section">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <Breadcrumbs items={breadcrumbItems} />

      <div class="hero-shell mt-6 px-5 py-7 sm:px-8 sm:py-10 lg:px-10">
        <div class="relative z-10 grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
          <div class="space-y-5">
            <p class="section-kicker">Thank you</p>
            <h1 class="max-w-3xl text-[2.25rem] font-display leading-[0.98] tracking-tight text-balance sm:text-5xl lg:text-6xl">
              A quick review helps a lot.
            </h1>
            <p class="max-w-2xl text-base leading-7 text-ink-soft sm:text-lg">
              Short, honest feedback, good or bad, helps local homeowners know what to expect and
              helps a small, owner-operated business keep growing.
            </p>
            <div class="flex flex-col gap-3 sm:flex-row">
              <a
                class="btn-primary px-7 py-3 text-center"
                href={business.reviewLinks.google}
                target="_blank"
                rel="noopener noreferrer"
                data-ga-event="cta_click"
                data-ga-label="review_google_primary"
              >
                Leave a Google review
              </a>
              <a
                class="btn-secondary px-7 py-3 text-center"
                href={`sms:${business.phoneTel}?body=${encodeURIComponent(
                  "Hi Maestros Services, I wanted to follow up about my recent service."
                )}`}
                data-ga-event="cta_click"
                data-ga-label="review_issue_text"
              >
                Need help with something?
              </a>
            </div>
          </div>

          <div class="surface-card relative z-10 p-5 sm:p-6">
            <p class="section-kicker">Good to know</p>
            <ul class="mt-5 space-y-3 text-sm text-ink-soft">
              {
                reviewNotes.map((note) => (
                  <li class="flex gap-3">
                    <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-ink/70" />
                    {note}
                  </li>
                ))
              }
            </ul>
            <div class="mt-5 rounded-2xl border border-ink/10 bg-white/80 p-4 text-sm text-ink-soft">
              <p class="font-semibold text-ink">Need help with your service?</p>
              <p class="mt-1">
                If something about your recent service needs attention, text or call {business.phone}
                and we will work with you to sort it out as quickly as possible.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section pt-0">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="mb-5 grid gap-5 rounded-[2rem] border border-border bg-white/90 p-6 shadow-soft lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:p-8">
        <div class="mx-auto w-full max-w-xs rounded-3xl border border-border bg-white p-5 shadow-fine">
          <img
            src="/review-qr.png"
            alt="QR code for the Maestros Services Google review page"
            width="260"
            height="260"
            class="mx-auto aspect-square w-full rounded-2xl object-contain"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="space-y-4">
          <p class="section-kicker">Scan to review</p>
          <h2 class="section-title text-3xl sm:text-4xl">The quickest way to leave a review.</h2>
          <p class="section-copy max-w-2xl">
            Scan the code with your phone camera and it takes you straight to our Google review
            form — no searching for us online, no typing in a web address.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              class="btn-primary px-6 py-3"
              href={business.reviewLinks.google}
              target="_blank"
              rel="noopener noreferrer"
              data-ga-event="cta_click"
              data-ga-label="review_qr_google"
            >
              Leave a Google review
            </a>
            <a
              class="btn-secondary px-6 py-3"
              href="/review-qr.png"
              target="_blank"
              rel="noopener noreferrer"
              data-ga-event="cta_click"
              data-ga-label="review_qr_open"
            >
              View a larger QR code
            </a>
          </div>
        </div>
      </div>

      <div class="grid gap-5 lg:grid-cols-3">
        <article class="surface-card p-6">
          <p class="section-kicker">Option 1</p>
          <h2 class="mt-2 text-2xl font-display">Leave a Google review</h2>
          <p class="mt-3 text-sm text-ink-soft">
            This is the most helpful review for local search and for future customers looking us up.
          </p>
          <a
            class="mt-5 btn-primary px-6 py-3"
            href={business.reviewLinks.google}
            target="_blank"
            rel="noopener noreferrer"
            data-ga-event="cta_click"
            data-ga-label="review_google_card"
          >
            Open Google
          </a>
        </article>

        <article class="surface-card p-6">
          <p class="section-kicker">Option 2</p>
          <h2 class="mt-2 text-2xl font-display">Recommend us on Facebook</h2>
          <p class="mt-3 text-sm text-ink-soft">
            A short recommendation on Facebook helps neighbors feel more comfortable reaching out.
          </p>
          <a
            class="mt-5 btn-secondary px-6 py-3"
            href={business.reviewLinks.facebook}
            target="_blank"
            rel="noopener noreferrer"
            data-ga-event="cta_click"
            data-ga-label="review_facebook_card"
          >
            Open Facebook
          </a>
        </article>

        <article class="surface-card p-6">
          <p class="section-kicker">Option 3</p>
          <h2 class="mt-2 text-2xl font-display">Send a referral</h2>
          <p class="mt-3 text-sm text-ink-soft">
            Know a neighbor who needs help with their yard, driveway, fence line, or cleanup? A quick
            text introduction is always appreciated.
          </p>
          <a
            class="mt-5 btn-secondary px-6 py-3"
            href={business.smsHref}
            data-ga-event="cta_click"
            data-ga-label="review_referral_text"
          >
            Text Maestros
          </a>
        </article>
      </div>
    </div>
  </section>
</Layout>
