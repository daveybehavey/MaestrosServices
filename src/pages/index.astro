---
import Layout from "../components/Layout.astro";
import QuoteForm from "../components/QuoteForm.astro";
import PropertyResetExamples from "../components/PropertyResetExamples.astro";
import { business } from "../data/business";
import {
  homepageFaqs,
  homepageOutcomeHighlights,
  homepagePackages,
  homepageServiceAreas,
  homepageServiceHighlights,
  homepageTrustMoments,
  homepageTrustProof,
  homepageTrustSignals,
} from "../data/homepage";
import { locations } from "../data/locations";
import { projectProfiles } from "../data/projects";
import { services as serviceCatalog } from "../data/services";
import {
  createFAQSchema,
  createHomepageBusinessSchema,
  createOrganizationSchema,
  createServiceSchema,
  createWebsiteSchema,
} from "../lib/schema";

const pageTitle = "Maestros Services | Landscaping, Power Washing & Driveway Work";
const metaDescription =
  "Owner-operated landscaping and exterior cleaning across lower-mid Vancouver Island. Power washing, driveway grading, gravel driveways, mulch, fence work, and cleanup.";
const canonicalUrl = `${business.siteUrl}${Astro.url.pathname}`;

const structuredData = [
  createFAQSchema(homepageFaqs),
  createHomepageBusinessSchema(homepageServiceAreas, homepageServiceHighlights, metaDescription),
  createOrganizationSchema(),
  createWebsiteSchema(),
  ...serviceCatalog.map((service) => createServiceSchema(service)),
];

const heroMedia = {
  desktopAvif: "/homepage/hero-desktop.avif",
  desktopWebp: "/homepage/hero-desktop.webp",
  mobileAvifCompact: "/homepage/hero-mobile.compact.avif",
  mobileAvifNarrow: "/homepage/hero-mobile.narrow.avif",
  mobileWebpCompact: "/homepage/hero-mobile.compact.webp",
  mobileWebpNarrow: "/homepage/hero-mobile.narrow.webp",
  alt: "Power washing a tidy residential driveway beside a landscaped front yard",
};

const galleryItems = [
  {
    label: "Power washing reset",
    image: "/homepage/hero-desktop.webp",
    alt: "Power washing a clean residential driveway beside tidy landscaping",
    detail: "Sharper curb appeal for patios, driveways, and walkways.",
  },
  {
    label: "Fresh edging and mowing",
    image: "/lawn.webp",
    alt: "Freshly edged lawn with clean borders",
    detail: "Clean lines that make a yard feel maintained right away.",
  },
  {
    label: "Seasonal cleanup complete",
    image: "/cleanup.webp",
    alt: "Yard after seasonal cleanup",
    detail: "Leaf, debris, and overgrowth cleanup without the mess.",
  },
  {
    label: "Garden bed refresh",
    image: "/garden.webp",
    alt: "Garden bed with fresh mulch and plants",
    detail: "Mulch, edging, and bed touch-ups that brighten the front of the home.",
  },
  {
    label: "Branded service snapshot",
    image: "/homepage/brand-cover.webp",
    alt: "Maestros Services branded landscaping and power washing cover image",
    detail: "A quick visual of the work types and brand feel homeowners see online.",
  },
];

const heroServiceLinks = [
  { label: "Power washing", href: "/services/power-washing" },
  { label: "Mulch refresh", href: "/services/garden-bed-maintenance" },
  { label: "Fence work", href: "/services/fence-work-minor-repairs" },
  { label: "Driveway grading", href: "/services/driveway-grading" },
];

const featuredAreaLinks = locations.slice(0, 12).map((location) => ({
    name: location.name,
    href: `/areas/${location.slug}`,
  }));
const hiddenAreaCount = Math.max(locations.length - featuredAreaLinks.length, 0);
---

<Layout
  title={pageTitle}
  description={metaDescription}
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
  quoteHref="#quote"
  analytics={{
    pageGroup: "homepage",
    pageType: "home",
    pageTemplate: "home",
  }}
  preloadImages={[
    {
      href: heroMedia.mobileAvifCompact,
      as: "image",
      type: "image/avif",
      media: "(max-width: 767px)",
      imagesrcset: `${heroMedia.mobileAvifCompact} 480w, ${heroMedia.mobileAvifNarrow} 640w`,
      imagesizes: "100vw",
    },
    {
      href: heroMedia.desktopAvif,
      as: "image",
      type: "image/avif",
      media: "(min-width: 768px)",
    },
  ]}
>
  <section class="section flex items-start pt-4 pb-4 sm:min-h-screen sm:items-center sm:pt-8 sm:pb-8 lg:pt-10 lg:pb-10">
    <div class="hero-shell mx-auto grid w-[calc(100%-2.5rem)] max-w-6xl gap-4 px-5 py-7 sm:w-[calc(100%-3rem)] sm:px-8 sm:py-10 lg:grid-cols-[1.04fr_0.96fr] lg:items-center lg:gap-8 lg:px-10 lg:py-12">
      <div class="relative z-10 space-y-4 sm:space-y-5 animate-rise" style="animation-delay: 50ms">
        <div class="mb-3 flex items-center gap-3 sm:mb-6 sm:gap-4">
          <div class="rounded-full border border-ink/10 bg-white/80 p-2 shadow-fine">
            <img
              src="/logo.webp?v=2"
              alt="Maestros Services lotus logo"
              class="h-10 w-10 sm:h-14 sm:w-14"
              width="64"
                height="64"
            />
          </div>
          <div class="leading-none">
            <p class="text-xl font-display font-semibold text-ink sm:text-3xl">Maestros Services</p>
            <p class="mt-1 text-[0.65rem] uppercase tracking-[0.3em] text-ink-soft sm:text-xs">
              Landscaping Services
            </p>
          </div>
        </div>
        <p class="section-kicker">Owner-operated across lower-mid Vancouver Island</p>
        <h1 class="max-w-3xl text-[2.15rem] font-display leading-[0.95] tracking-tight text-balance sm:text-5xl lg:text-6xl">
          Landscaping and exterior cleaning for cleaner homes, sharper curb appeal, and faster quotes.
        </h1>
        <p class="max-w-2xl text-base leading-7 text-ink-soft sm:text-lg">
          Based near Shawnigan Lake and serving Victoria, Langford, Saanich, Mill Bay, Duncan, and nearby
          communities. We help homeowners with power washing, driveway resets, cleanup, mulch refreshes,
          fence work, and tidy property improvement. Call or text first for the fastest quote.
        </p>
        <div class="flex flex-wrap gap-2 text-[0.72rem] font-medium text-ink-soft sm:text-xs">
          {heroServiceLinks.map((item) => (
            <a
              href={item.href}
              class="rounded-full border border-border bg-white/90 px-3 py-1.5 leading-none transition hover:border-ink/25 hover:text-ink"
            >
              {item.label}
            </a>
          ))}
        </div>
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
          <a
            class="btn-primary w-full px-6 py-3 text-center shadow-fine sm:w-auto sm:px-8 sm:py-4"
            href={`tel:${business.phoneTel}`}
            data-ga-event="cta_click"
            data-ga-label="hero_call_text"
          >
            Call or text now
          </a>
          <a
            class="btn-secondary w-full px-6 py-3 text-center sm:w-auto sm:px-8 sm:py-4"
            href={business.smsHref}
            data-ga-event="cta_click"
            data-ga-label="hero_text_photos"
          >
            Text photos
          </a>
          <a
            class="btn-secondary w-full px-6 py-3 text-center sm:w-auto sm:px-8 sm:py-4"
            href="#quote"
            data-ga-event="cta_click"
            data-ga-label="hero_get_quote"
          >
            Get a free quote
          </a>
        </div>
        <div class="flex flex-wrap gap-2 text-[0.68rem] font-medium text-ink-soft sm:text-xs">
          <span class="rounded-full border border-border bg-white/90 px-3 py-1.5 leading-none">
            Owner-operated
          </span>
          <span class="rounded-full border border-border bg-white/90 px-3 py-1.5 leading-none">
            Fast replies during work hours
          </span>
          <span class="rounded-full border border-border bg-white/90 px-3 py-1.5 leading-none">
            Residential only
          </span>
        </div>
        <div id="hero-sentinel" class="h-1"></div>
      </div>
      <div class="relative z-10 animate-rise" style="animation-delay: 150ms">
        <div class="surface-card overflow-hidden p-2 sm:p-3">
          <div class="relative overflow-hidden rounded-[1.5rem] border border-border bg-paper">
            <picture>
              <source media="(min-width: 768px)" type="image/avif" srcset={heroMedia.desktopAvif} />
              <source media="(min-width: 768px)" type="image/webp" srcset={heroMedia.desktopWebp} />
              <source
                media="(max-width: 767px)"
                type="image/avif"
                srcset={`${heroMedia.mobileAvifCompact} 480w, ${heroMedia.mobileAvifNarrow} 640w`}
                sizes="100vw"
              />
              <source
                media="(max-width: 767px)"
                type="image/webp"
                srcset={`${heroMedia.mobileWebpCompact} 480w, ${heroMedia.mobileWebpNarrow} 640w`}
                sizes="100vw"
              />
              <img
                src={heroMedia.mobileWebpCompact}
                alt={heroMedia.alt}
                class="aspect-[4/5] h-full w-full object-cover md:aspect-[16/10]"
                width="480"
                height="750"
                fetchpriority="high"
                decoding="async"
                sizes="(min-width: 768px) 48vw, 100vw"
              />
            </picture>
            <div class="absolute inset-0 bg-gradient-to-t from-ink/35 via-transparent to-transparent"></div>
            <div class="absolute inset-x-4 bottom-4 flex flex-wrap items-center gap-2">
              <span class="rounded-full border border-white/35 bg-white/88 px-3 py-1 text-[0.68rem] font-medium text-ink">
                Power washing
              </span>
              <span class="rounded-full border border-white/35 bg-white/88 px-3 py-1 text-[0.68rem] font-medium text-ink">
                Driveway resets
              </span>
              <span class="rounded-full border border-white/35 bg-white/88 px-3 py-1 text-[0.68rem] font-medium text-ink">
                Tidy finishes
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section pt-2 sm:pt-0 content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="grid gap-6 rounded-[2rem] border border-border bg-white/92 p-6 shadow-soft sm:p-8 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="space-y-3">
          <p class="section-kicker">Why homeowners feel comfortable reaching out</p>
          <h2 class="text-2xl font-display sm:text-3xl">Clear communication, practical scope, and real proof.</h2>
          <p class="text-sm leading-7 text-ink-soft">
            We do not rely on flashy promises. The goal is to make it easy to understand what fits,
            what happens next, and why the finished result should feel worth it.
          </p>
          <div class="flex flex-wrap gap-2 text-xs text-ink-soft">
            {homepageTrustProof.map((item) => (
              <span class="rounded-full border border-border bg-paper px-3 py-1.5">{item}</span>
            ))}
          </div>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          {homepageTrustMoments.map((item) => (
            <article class="rounded-2xl border border-border bg-paper/55 p-5">
              <p class="text-base font-semibold text-ink">{item.title}</p>
              <p class="mt-2 text-sm text-ink-soft">{item.detail}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section pt-2 sm:pt-0 content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="grid gap-6 rounded-[2rem] border border-border bg-white/90 p-6 shadow-fine sm:p-8 lg:grid-cols-[1fr_0.95fr] lg:items-center">
        <div class="space-y-3">
          <p class="section-kicker">Reviews and reputation</p>
          <h2 class="text-2xl font-display sm:text-3xl">Want to sanity-check us first?</h2>
          <p class="text-sm leading-7 text-ink-soft">
            That is completely fair. You can read reviews, see the way we ask for feedback, and get a
            feel for how we handle homeowner communication before you ever request a quote.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              class="rounded-full bg-ink px-6 py-3 text-sm font-semibold text-paper hover:bg-ink/90"
              href={business.reviewLinks.google}
              target="_blank"
              rel="noreferrer"
              data-ga-event="cta_click"
              data-ga-label="homepage_reviews_google"
            >
              Read Google reviews
            </a>
            <a
              class="rounded-full border border-ink/20 px-6 py-3 text-sm font-semibold hover:border-ink"
              href="/review"
              data-ga-event="cta_click"
              data-ga-label="homepage_review_page"
            >
              See how feedback works
            </a>
          </div>
        </div>
        <div class="rounded-2xl border border-ink/10 bg-paper/70 p-5 sm:p-6">
          <p class="text-xs uppercase tracking-[0.24em] text-ink-soft">What homeowners usually care about</p>
          <ul class="mt-4 space-y-3 text-sm text-ink-soft">
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-ink/70"></span>
              Will the job feel straightforward from quote to cleanup?
            </li>
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-ink/70"></span>
              Will the property be treated carefully and left tidy?
            </li>
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-ink/70"></span>
              Will someone be honest if a simpler fix makes more sense?
            </li>
          </ul>
          <p class="mt-4 text-sm font-semibold text-ink">
            Those are exactly the trust points we try to make obvious early.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="gallery" class="section content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-6 sm:mb-10">
        <div class="space-y-3">
          <p class="section-kicker">Service examples</p>
          <h2 class="section-title">A few examples of the clean, finished look we aim for.</h2>
        </div>
        <p class="section-copy max-w-md">
          We only share photos we have permission to use, with details kept general when needed.
        </p>
      </div>
      <div class="rounded-[2rem] border border-border bg-white/92 p-4 shadow-soft sm:p-6" data-gallery>
        <div class="grid gap-5 lg:grid-cols-[1.08fr_0.92fr] lg:items-stretch">
          <div class="relative min-w-0">
            <div class="relative overflow-hidden rounded-[1.6rem] border border-border bg-paper/70">
              <div class="relative aspect-[4/3] sm:aspect-[16/10]">
                {galleryItems.map((item, index) => (
                  <figure
                    class:list={[
                      "absolute inset-0 flex flex-col justify-end opacity-0 transition duration-500 ease-out",
                      index === 0 && "opacity-100",
                    ]}
                    data-gallery-slide
                    data-gallery-index={index}
                    aria-hidden={index === 0 ? "false" : "true"}
                  >
                    <img
                      src={item.image}
                      alt={item.alt}
                      width="1200"
                      height="900"
                      class="absolute inset-0 h-full w-full object-cover"
                      loading={index === 0 ? "eager" : "lazy"}
                      decoding="async"
                      sizes="(min-width: 1024px) 60vw, 100vw"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-ink/55 via-ink/10 to-transparent"></div>
                    <figcaption class="relative z-10 p-5 sm:p-6">
                      <p class="text-sm font-semibold text-paper sm:text-base">{item.label}</p>
              <p class="mt-1 max-w-xl text-sm text-paper/80">{item.detail}</p>
                    </figcaption>
                  </figure>
                ))}
              </div>
            </div>
            <div class="mt-3 flex items-center justify-between gap-3">
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-border bg-white/92 text-ink transition hover:border-ink/30 hover:bg-paper"
                  data-gallery-prev
                  aria-label="Previous gallery item"
                >
                  <span aria-hidden="true">←</span>
                </button>
                <button
                  type="button"
                  class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-border bg-white/92 text-ink transition hover:border-ink/30 hover:bg-paper"
                  data-gallery-next
                  aria-label="Next gallery item"
                >
                  <span aria-hidden="true">→</span>
                </button>
              </div>
              <p class="text-xs uppercase tracking-[0.22em] text-ink-soft">Swipe or use arrows</p>
            </div>
          </div>

          <div class="flex min-w-0 flex-col justify-between gap-4 rounded-[1.6rem] border border-border bg-paper/70 p-5 sm:p-6">
            <div class="space-y-3">
              <p class="section-kicker">What homeowners usually want to see</p>
              <h3 class="text-2xl font-display sm:text-3xl">Real work, clean finishes, and a clear next step.</h3>
              <p class="text-sm leading-7 text-ink-soft">
                The gallery is meant to show the kind of results we talk about on the service pages without turning
                the homepage into a noisy slideshow.
              </p>
            </div>
            <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-1">
              {galleryItems.map((item, index) => (
                <button
                  type="button"
                  class="flex items-start gap-3 rounded-2xl border border-border bg-white/88 p-3 text-left transition hover:border-ink/25"
                  data-gallery-dot
                  data-gallery-index={index}
                  aria-pressed={index === 0 ? "true" : "false"}
                >
                  <span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-ink/10 bg-paper text-xs font-semibold text-ink">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <span class="min-w-0">
                    <span class="block text-sm font-semibold text-ink">{item.label}</span>
                    <span class="mt-1 block text-xs text-ink-soft">Tap to open.</span>
                  </span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section pt-2 sm:pt-0 content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-6 sm:mb-10">
        <div class="space-y-3">
          <p class="section-kicker">Project types</p>
          <h2 class="section-title">Scope that goes beyond basic cleanup.</h2>
        </div>
        <a
          class="text-sm font-semibold text-ink hover:text-ink/70"
          href="/projects"
          data-ga-event="cta_click"
          data-ga-label="homepage_project_types"
        >
          See all project profiles -&gt;
        </a>
      </div>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {projectProfiles.map((project, index) => (
          <article
            class="rounded-2xl border border-border bg-white/90 p-5 shadow-fine animate-rise"
            style={`animation-delay: ${index * 70}ms`}
          >
            <p class="text-lg font-semibold">{project.title}</p>
            <p class="mt-2 text-sm text-ink-soft">{project.summary}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {project.relatedServiceHrefs.slice(0, 2).map((related) => (
                <a
                  href={related.href}
                  class="rounded-full border border-border bg-paper px-3 py-1 text-xs text-ink-soft transition hover:border-ink/30 hover:text-ink"
                >
                  {related.label}
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="services" class="section content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-6 sm:mb-10">
        <div class="space-y-3">
          <p class="section-kicker">Services</p>
          <h2 class="section-title">Everything your yard needs to look its best.</h2>
        </div>
        <p class="section-copy max-w-md">
          We handle both recurring maintenance and larger exterior projects. That includes lawns, planting
          areas, mulching, brush clearing, power washing, rock work, driveway grading, and gravel driveway upgrades.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {serviceCatalog.map((service, index) => (
          <a
            href={`/services/${service.slug}`}
            class="lift-card group p-6 animate-rise"
            style={`animation-delay: ${index * 60}ms`}
          >
            <div class="mb-5 flex items-center justify-between gap-4">
              <span class="service-mark">{String(index + 1).padStart(2, "0")}</span>
              <span class="h-px flex-1 bg-border"></span>
            </div>
            <p class="text-base font-semibold">{service.name}</p>
            <p class="mt-2 text-sm text-ink-soft">{service.description}</p>
            <p class="mt-3 text-sm font-semibold text-ink group-hover:text-ink/70">View service -&gt;</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section content-auto">
    <div class="mx-auto grid max-w-6xl gap-8 px-5 sm:gap-10 sm:px-6 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="space-y-4">
        <p class="section-kicker">Book-now offers</p>
        <h2 class="section-title">Fast bookings this week.</h2>
        <p class="section-copy">
          These are the fastest-turn services we are pushing right now to fill nearby routes.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {homepagePackages.map((item, index) => (
          <div class="rounded-2xl border border-border bg-white/85 p-6 animate-rise" style={`animation-delay: ${index * 80}ms`}>
            <p class="text-lg font-semibold">{item.name}</p>
            <p class="text-sm text-ink-soft">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="grid gap-6 rounded-[2rem] border border-border bg-white/85 p-7 shadow-soft sm:gap-8 sm:p-9 lg:grid-cols-3 lg:p-10">
        <div class="space-y-3">
          <p class="section-kicker">How it works</p>
          <h2 class="section-title text-2xl sm:text-3xl">A simple process from start to finish.</h2>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-border bg-white/90 p-5 shadow-fine">
            <p class="text-sm font-semibold">1. Reach out</p>
            <p class="text-sm text-ink-soft">Call, text, or send the form with a few details.</p>
          </div>
          <div class="rounded-xl border border-border bg-white/90 p-5 shadow-fine">
            <p class="text-sm font-semibold">2. Quick quote</p>
            <p class="text-sm text-ink-soft">We confirm scope, timing, and a clear price.</p>
          </div>
          <div class="rounded-xl border border-border bg-white/90 p-5 shadow-fine">
            <p class="text-sm font-semibold">3. We show up</p>
            <p class="text-sm text-ink-soft">You get a tidy, cared-for yard you can relax in.</p>
          </div>
        </div>
        <div class="grid-dots rounded-xl border border-ink/10 p-4 text-sm text-ink-soft">
          <p class="font-semibold text-ink">Fast replies</p>
          <p>We aim to reply within 1 hour during work hours.</p>
          <p class="mt-3 font-semibold text-ink">Service area</p>
          <p>Lower-mid Vancouver Island.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section pt-2 sm:pt-0 content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="mb-6 space-y-3 sm:mb-10">
        <p class="section-kicker">Service standards</p>
        <h2 class="section-title">What you can count on, even before photos or reviews.</h2>
