---
import Layout from "../components/Layout.astro";
import QuoteForm from "../components/QuoteForm.astro";
import { business } from "../data/business";
import {
  homepageFaqs,
  homepageServiceAreas,
  homepageServiceHighlights,
  homepageTrustMoments,
  homepageTrustProof,
} from "../data/homepage";
import { locations } from "../data/locations";
import { services as serviceCatalog } from "../data/services";
import {
  createFAQSchema,
  createHomepageBusinessSchema,
  createOrganizationSchema,
  createServiceSchema,
  createWebsiteSchema,
} from "../lib/schema";

const pageTitle = "Maestros Services | Landscaping & Exterior Cleanup on Vancouver Island";
const metaDescription =
  "Owner-operated landscaping, power washing, driveway work, fence repairs, and cleanups across lower-mid Vancouver Island. Direct replies and low-pressure quotes.";
const canonicalUrl = `${business.siteUrl}${Astro.url.pathname}`;

const structuredData = [
  createFAQSchema(homepageFaqs),
  createHomepageBusinessSchema(homepageServiceAreas, homepageServiceHighlights, metaDescription),
  createOrganizationSchema(),
  createWebsiteSchema(),
  ...serviceCatalog.map((service) => createServiceSchema(service)),
];

const heroImage = "/garden.webp";

const featuredServiceSlugs = [
  "power-washing",
  "garden-bed-maintenance",
  "fence-work-minor-repairs",
  "driveway-grading",
] as const;

const featuredServices = featuredServiceSlugs.flatMap((slug) =>
  serviceCatalog.filter((service) => service.slug === slug),
);

const galleryItems = [
  {
    kind: "image",
    label: "Garden bed refresh",
    image: "/garden.webp",
    alt: "Well-kept front garden with clean edges and mulch",
    detail: "Sharper bed lines and a cleaner front-yard finish.",
  },
  {
    kind: "image",
    label: "Seasonal cleanup",
    image: "/cleanup.webp",
    alt: "Leaf cleanup with a rake and tidy lawn",
    detail: "A practical reset before weather changes or guests arrive.",
  },
  {
    kind: "image",
    label: "Clean lawn detail",
    image: "/lawn.webp",
    alt: "Clean lawn edge with mulched planting area",
    detail: "A tidy edge and a finish that reads well from the street.",
  },
  {
    kind: "cta",
    label: "Need a quick quote?",
    detail:
      "Send a couple of photos, your area, and timing. We will reply with the practical next step.",
    ctaHref: "#quote",
  },
] as const;

const featuredAreaLinks = locations.slice(0, 12).map((location) => ({
  name: location.name,
  href: `/areas/${location.slug}`,
}));

const hiddenAreaCount = Math.max(locations.length - featuredAreaLinks.length, 0);
---

<Layout
  title={pageTitle}
  description={metaDescription}
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
  quoteHref="#quote"
  headerVariant="simple"
  showMobileCTA={false}
  showDesktopCTA={false}
  preloadImages={[
    {
      href: heroImage,
      type: "image/webp",
    },
  ]}
  analytics={{
    pageGroup: "homepage",
    pageType: "home",
    pageTemplate: "home",
  }}
>
  <section class="relative isolate min-h-[100svh] overflow-hidden">
    <div class="absolute inset-0">
      <img
        src={heroImage}
        alt="Clean front yard with fresh landscaping and neat garden beds"
        class="h-full w-full object-cover object-[center_28%] sm:object-[center_34%] lg:object-center"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-br from-ink/70 via-ink/35 to-ink/10"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(255,255,255,0.1),transparent_38%),radial-gradient(circle_at_80%_30%,rgba(255,255,255,0.08),transparent_36%),linear-gradient(180deg,transparent,rgba(0,0,0,0.18))]"></div>
    </div>

    <div class="relative mx-auto flex min-h-[100svh] max-w-6xl items-start px-4 pb-6 pt-20 sm:px-6 sm:pb-10 sm:pt-24 lg:items-center lg:px-8 lg:py-10">
      <div class="max-w-xl animate-rise">
        <div class="rounded-[2rem] border border-white/25 bg-white/86 p-5 shadow-soft backdrop-blur-xl sm:p-8 lg:p-10">
          <div class="flex flex-wrap items-center gap-3">
            <div class="rounded-full border border-ink/10 bg-white/90 px-3 py-1 text-[0.66rem] font-semibold uppercase tracking-[0.3em] text-ink-soft">
              Owner-operated across lower-mid Vancouver Island
            </div>
            <div class="rounded-full border border-ink/10 bg-white/90 px-3 py-1 text-[0.66rem] font-semibold uppercase tracking-[0.3em] text-ink-soft">
              Residential only
            </div>
          </div>
          <p class="mt-4 text-[0.68rem] font-medium uppercase tracking-[0.28em] text-ink-soft">
            Call or text for the fastest response
          </p>
          <h1 class="mt-4 max-w-xl text-[2.3rem] font-display leading-[0.95] tracking-tight text-ink text-balance sm:text-5xl lg:text-6xl">
            Landscaping and exterior cleanup that makes your property feel cared for.
          </h1>
          <p class="mt-4 max-w-lg text-base leading-7 text-ink-soft sm:text-lg">
            Based near Shawnigan Lake and serving Victoria, Langford, Saanich, Mill Bay, Duncan, and nearby communities.
            Send a photo, your area, and timing, and we will reply with the practical next step.
          </p>
          <div class="mt-5 hidden flex-wrap gap-2 text-[0.72rem] font-medium text-ink-soft sm:flex sm:text-xs">
            {homepageTrustProof.map((item) => (
              <span class="rounded-full border border-border bg-white/90 px-3 py-1.5 leading-none shadow-[0_1px_0_rgba(0,0,0,0.03)]">
                {item}
              </span>
            ))}
          </div>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
            <a
              class="btn-primary w-full px-6 py-3 text-center shadow-fine sm:w-auto sm:px-8 sm:py-4"
              href={`tel:${business.phoneTel}`}
              data-ga-event="cta_click"
              data-ga-label="hero_call_text"
            >
              Call or text now
            </a>
            <a
              class="btn-secondary w-full px-6 py-3 text-center sm:w-auto sm:px-8 sm:py-4"
              href="#quote"
              data-ga-event="cta_click"
              data-ga-label="hero_get_quote"
            >
              Get a quote
            </a>
          </div>
          <p class="mt-3 text-sm leading-7 text-ink-soft">
            Prefer to text photos first?
            <a
              class="font-semibold text-ink underline decoration-ink/25 underline-offset-4 hover:decoration-ink/60"
              href={business.smsHref}
              data-ga-event="cta_click"
              data-ga-label="hero_text_photos"
            >
              Send them here
            </a>
            and we’ll reply with the practical next step.
          </p>
          <div class="mt-5 hidden flex-wrap gap-2 text-xs text-ink-soft sm:flex">
            <span class="rounded-full border border-border bg-paper px-3 py-1.5">Power washing</span>
            <span class="rounded-full border border-border bg-paper px-3 py-1.5">Gravel driveways</span>
            <span class="rounded-full border border-border bg-paper px-3 py-1.5">Cleanup and mulch</span>
            <span class="rounded-full border border-border bg-paper px-3 py-1.5">Fence work</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section pt-6 sm:pt-10 content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="grid gap-4 md:grid-cols-3">
        {homepageTrustMoments.map((item, index) => (
          <article
            class="rounded-[1.75rem] border border-border bg-white/92 p-6 shadow-fine animate-rise"
            style={`animation-delay: ${index * 70}ms`}
          >
            <p class="section-kicker">{item.title}</p>
            <p class="mt-3 text-sm leading-7 text-ink-soft">{item.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="services" class="section content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-6 sm:mb-8">
        <div class="space-y-3">
          <p class="section-kicker">Featured services</p>
          <h2 class="section-title">The fastest-turn services we want more of.</h2>
        </div>
        <p class="section-copy max-w-md">
          Tight, high-intent services that are easier to quote quickly and easier for homeowners to say yes to.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {featuredServices.map((service, index) => (
          <a
            href={`/services/${service.slug}`}
            class="lift-card group p-6 animate-rise"
            style={`animation-delay: ${index * 60}ms`}
          >
            <div class="mb-5 flex items-center justify-between gap-4">
              <span class="service-mark">{String(index + 1).padStart(2, "0")}</span>
              <span class="h-px flex-1 bg-border"></span>
            </div>
            <p class="text-base font-semibold">{service.name}</p>
            <p class="mt-2 text-sm leading-7 text-ink-soft">{service.description}</p>
            <p class="mt-4 text-sm font-semibold text-ink group-hover:text-ink/70">View service -&gt;</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="gallery" class="section content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-6 sm:mb-8">
        <div class="space-y-3">
          <p class="section-kicker">Recent work</p>
          <h2 class="section-title">Swipe through a few examples of the finished look we aim for.</h2>
        </div>
        <p class="section-copy max-w-md">
          Clean, simple, and permission-friendly. The point is proof, not noise.
        </p>
      </div>
      <div class="gallery-rail -mx-5 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 sm:-mx-6 sm:px-6 lg:mx-0 lg:px-0">
        {galleryItems.map((item, index) => (
          <article
            class="gallery-card group min-w-[82vw] snap-start overflow-hidden rounded-[1.75rem] border border-border bg-white/92 shadow-fine sm:min-w-[24rem] lg:min-w-[22rem] animate-rise"
            style={`animation-delay: ${index * 70}ms`}
          >
            {"image" in item ? (
              <>
                <div class="relative aspect-[4/3] overflow-hidden bg-paper/80">
                  <img
                    src={item.image}
                    alt={item.alt}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="p-5">
                  <p class="text-sm font-semibold text-ink">{item.label}</p>
                  <p class="mt-2 text-sm leading-7 text-ink-soft">{item.detail}</p>
                </div>
              </>
            ) : (
              <div class="flex h-full min-h-[24rem] flex-col justify-between p-6 sm:p-7">
                <div>
                  <p class="section-kicker">Need a quick quote?</p>
                  <h3 class="mt-3 text-2xl font-display text-ink">{item.label}</h3>
                  <p class="mt-4 text-sm leading-7 text-ink-soft">{item.detail}</p>
                </div>
                <a
                  class="btn-primary mt-6 w-full px-5 py-3 text-center sm:w-auto"
                  href={item.ctaHref}
                  data-ga-event="cta_click"
                  data-ga-label="gallery_quote_prompt"
                >
                  Get a quote
                </a>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="grid gap-6 rounded-[2rem] border border-border bg-white/92 p-6 shadow-soft sm:p-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
        <div class="space-y-3">
          <p class="section-kicker">Reviews and reputation</p>
          <h2 class="text-2xl font-display sm:text-3xl">Want to sanity-check us first?</h2>
          <p class="text-sm leading-7 text-ink-soft">
            That is completely fair. You can read reviews, see the way we ask for feedback, and get a feel
            for how we communicate before you ever request a quote.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              class="rounded-full bg-ink px-6 py-3 text-sm font-semibold text-paper hover:bg-ink/90"
              href={business.reviewLinks.google}
              target="_blank"
              rel="noreferrer"
              data-ga-event="cta_click"
              data-ga-label="homepage_reviews_google"
            >
              Read Google reviews
            </a>
            <a
              class="rounded-full border border-ink/20 px-6 py-3 text-sm font-semibold hover:border-ink"
              href="/review"
              data-ga-event="cta_click"
              data-ga-label="homepage_review_page"
            >
              See how feedback works
            </a>
          </div>
        </div>
        <div class="rounded-[1.5rem] border border-ink/10 bg-paper/70 p-5 sm:p-6">
          <p class="text-xs uppercase tracking-[0.24em] text-ink-soft">What homeowners usually care about</p>
          <ul class="mt-4 space-y-3 text-sm text-ink-soft">
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-ink/70"></span>
              Will the job feel straightforward from quote to cleanup?
            </li>
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-ink/70"></span>
              Will the property be treated carefully and left tidy?
            </li>
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-ink/70"></span>
              Will someone be honest if a simpler fix makes more sense?
            </li>
          </ul>
          <p class="mt-4 text-sm font-semibold text-ink">
            Those are exactly the trust points we try to make obvious early.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="service-area" class="section content-auto">
    <div class="mx-auto grid max-w-6xl gap-8 px-5 sm:gap-10 sm:px-6 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="space-y-4">
        <p class="section-kicker">Service area</p>
        <h2 class="section-title">Serving lower-mid Vancouver Island.</h2>
        <p class="section-copy">
          Based near Shawnigan Lake and serving nearby communities across the lower-mid island. If you are close by, ask
          and we will confirm availability.
        </p>
        <a class="text-sm font-semibold text-ink hover:text-ink/70" href="/service-area" data-ga-event="cta_click" data-ga-label="service_area_page">
          View full service area -&gt;
        </a>
        <div class="flex flex-wrap gap-3 text-sm text-ink-soft">
          {featuredAreaLinks.map((area) => (
            <a
              href={area.href}
              class="rounded-full border border-border bg-white/90 px-4 py-1 transition hover:border-ink/30 hover:text-ink"
            >
              {area.name}
            </a>
          ))}
          <a
            href="/service-area"
            class="rounded-full border border-ink/20 bg-paper px-4 py-1 font-semibold text-ink transition hover:border-ink"
          >
            {hiddenAreaCount > 0 ? `+ ${hiddenAreaCount} more areas` : "View service area"}
          </a>
        </div>
      </div>
      <div class="space-y-5">
        <div class="rounded-[1.75rem] border border-border bg-white/92 p-6 shadow-fine">
          <p class="section-kicker">Local map</p>
          <h3 class="text-xl sm:text-2xl">Lower-mid island service area</h3>
          <div class="mt-5 flex items-center justify-center rounded-[1.5rem] border border-border bg-white p-5 text-ink/80">
            <picture class="block w-full">
              <source srcset="/VIMAP.svg?v=2" type="image/svg+xml" />
              <img
                src="/VIMAP.png?v=2"
                alt="Map of lower-mid Vancouver Island service area"
                width="400"
                height="256"
                class="mx-auto h-56 w-auto max-w-full rounded-xl object-contain sm:h-64"
                loading="lazy"
                decoding="async"
                sizes="(min-width: 1024px) 26rem, 100vw"
              />
            </picture>
          </div>
        </div>
        <div class="rounded-[1.75rem] border border-border bg-white/92 p-6 shadow-fine">
          <p class="section-kicker">Fast quote path</p>
          <h3 class="text-2xl">Call or text for the fastest response.</h3>
          <div class="mt-5 space-y-3 text-sm">
            <a
              class="block rounded-xl bg-ink px-4 py-3 text-center font-semibold text-paper hover:bg-ink/90"
              href={`tel:${business.phoneTel}`}
              data-ga-event="cta_click"
              data-ga-label="service_area_call"
            >
              {business.phone}
            </a>
            <a
              class="block rounded-xl border border-ink/15 bg-white/90 px-4 py-3 text-center hover:border-ink"
              href={`mailto:${business.email}`}
              data-ga-event="cta_click"
              data-ga-label="service_area_email"
            >
              {business.email}
            </a>
          </div>
          <p class="mt-4 text-xs uppercase tracking-[0.3em] text-ink-soft">Residential only</p>
        </div>
      </div>
    </div>
  </section>

  <section id="faq" class="section content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="mb-6 space-y-3 sm:mb-8">
        <p class="section-kicker">FAQ</p>
        <h2 class="section-title">Common questions.</h2>
      </div>
      <div class="grid gap-4 lg:grid-cols-2">
        {homepageFaqs.map((faq, index) => (
          <div
            class="rounded-[1.5rem] border border-border bg-white/92 p-6 shadow-fine animate-rise"
            style={`animation-delay: ${index * 60}ms`}
          >
            <p class="text-base font-semibold">{faq.question}</p>
            <p class="mt-2 text-sm leading-7 text-ink-soft">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="quote" class="section content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <QuoteForm showInfoBox={true} />
    </div>
  </section>
</Layout>
