---
import Layout from "../components/Layout.astro";
import QuoteForm from "../components/QuoteForm.astro";
import PropertyResetExamples from "../components/PropertyResetExamples.astro";
import { business } from "../data/business";
import {
  homepageFaqs,
  homepageOutcomeHighlights,
  homepagePackages,
  homepageServiceAreas,
  homepageServiceHighlights,
  homepageTrustMoments,
  homepageTrustProof,
  homepageTrustSignals,
} from "../data/homepage";
import { locations } from "../data/locations";
import { projectProfiles } from "../data/projects";
import { services as serviceCatalog } from "../data/services";
import {
  createFAQSchema,
  createHomepageBusinessSchema,
  createOrganizationSchema,
  createServiceSchema,
  createWebsiteSchema,
} from "../lib/schema";

const pageTitle = "Maestros Services | Landscaping Services on Vancouver Island";
const metaDescription =
  "Maestros Services provides reliable landscaping services across lower-mid Vancouver Island, including fence work, rock work, mulching, power washing, driveway grading, gravel driveway work, and property improvement projects.";
const canonicalUrl = `${business.siteUrl}${Astro.url.pathname}`;

const structuredData = [
  createFAQSchema(homepageFaqs),
  createHomepageBusinessSchema(homepageServiceAreas, homepageServiceHighlights, metaDescription),
  createOrganizationSchema(),
  createWebsiteSchema(),
  ...serviceCatalog.map((service) => createServiceSchema(service)),
];

const galleryItems = [
  {
    label: "Fresh edging and mowing",
    image: "/lawn.webp",
    alt: "Freshly edged lawn with clean borders",
  },
  {
    label: "Seasonal cleanup complete",
    image: "/cleanup.webp",
    alt: "Yard after seasonal cleanup",
  },
  {
    label: "Garden bed refresh",
    image: "/garden.webp",
    alt: "Garden bed with fresh mulch and plants",
  },
];

const heroServiceLinks = [
  { label: "Power washing", href: "/services/power-washing" },
  { label: "Mulch refresh", href: "/services/garden-bed-maintenance" },
  { label: "Fence work", href: "/services/fence-work-minor-repairs" },
  { label: "Driveway grading", href: "/services/driveway-grading-repair" },
];

const featuredAreaLinks = locations.slice(0, 12).map((location) => ({
    name: location.name,
    href: `/areas/${location.slug}`,
  }));
const hiddenAreaCount = Math.max(locations.length - featuredAreaLinks.length, 0);
---

<Layout
  title={pageTitle}
  description={metaDescription}
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
  quoteHref="#quote"
  analytics={{
    pageGroup: "homepage",
    pageType: "home",
    pageTemplate: "home",
  }}
>
  <section class="section flex items-start pt-4 pb-4 sm:min-h-screen sm:items-center sm:pt-8 sm:pb-8 lg:pt-10 lg:pb-10">
    <div class="hero-shell mx-auto grid w-[calc(100%-2.5rem)] max-w-6xl gap-4 px-5 py-7 sm:w-[calc(100%-3rem)] sm:px-8 sm:py-10 lg:grid-cols-[1.08fr_0.92fr] lg:items-center lg:px-10 lg:py-12">
      <div class="relative z-10 space-y-3 sm:space-y-5 animate-rise" style="animation-delay: 50ms">
        <div class="mb-3 sm:mb-6 flex items-center gap-3 sm:gap-4">
          <div class="rounded-full border border-ink/10 bg-white/80 p-2 shadow-fine">
            <img src="/logo.png?v=2" alt="Maestros Services lotus logo" class="h-10 w-10 sm:h-14 sm:w-14" width="64" height="64" />
          </div>
          <div class="leading-none">
            <p class="text-xl font-display font-semibold text-ink sm:text-3xl">Maestros Services</p>
            <p class="mt-1 text-[0.65rem] sm:text-xs uppercase tracking-[0.3em] text-ink-soft">Landscaping Services</p>
          </div>
        </div>
        <p class="section-kicker">Owner-operated across lower-mid Vancouver Island</p>
        <h1 class="max-w-3xl text-[2.15rem] font-display leading-[0.95] tracking-tight text-balance sm:text-5xl lg:text-7xl">
          Owner-operated landscaping for cleaner yards, sharper edges, and faster quotes.
        </h1>
        <p class="max-w-2xl text-base leading-7 text-ink-soft sm:text-lg">
          Based near Shawnigan Lake and serving Victoria, Langford, Saanich, Mill Bay, Duncan, and nearby communities.
          We help homeowners with power washing, mulch refreshes, fence work, cleanups, and driveway resets.
          Call or text first for the fastest quote. We usually reply within 1 hour during work hours.
        </p>
        <div class="flex flex-wrap gap-2 text-[0.72rem] font-medium text-ink-soft sm:text-xs">
          {heroServiceLinks.map((item) => (
            <a
              href={item.href}
              class="rounded-full border border-border bg-white/90 px-3 py-1.5 leading-none transition hover:border-ink/25 hover:text-ink"
            >
              {item.label}
            </a>
          ))}
        </div>
        <div class="mb-6 sm:mb-8 flex flex-col items-start gap-1 sm:gap-2">
          <p class="text-[0.65rem] sm:text-xs uppercase tracking-[0.3em] text-ink-soft">Call or text for a fast residential quote</p>
          <a
            class="text-xl font-display font-semibold text-ink hover:text-ink/70 sm:text-3xl lg:text-4xl"
            href={`tel:${business.phoneTel}`}
            data-ga-event="cta_click"
            data-ga-label="hero_phone_primary"
          >
            {business.phone}
          </a>
        </div>
        <div class="flex flex-col gap-2 sm:gap-3 sm:flex-row sm:items-center">
          <a
            class="btn-primary w-full px-6 py-3 text-center shadow-fine sm:w-auto sm:px-8 sm:py-4"
            href={`tel:${business.phoneTel}`}
            data-ga-event="cta_click"
            data-ga-label="hero_call_text"
          >
            Call or text now
          </a>
          <a
            class="btn-secondary w-full px-6 py-3 text-center sm:w-auto sm:px-8 sm:py-4"
            href={business.smsHref}
            data-ga-event="cta_click"
            data-ga-label="hero_text_photos"
          >
            Text photos
          </a>
          <a
            class="btn-secondary w-full px-6 py-3 text-center sm:w-auto sm:px-8 sm:py-4"
            href="#quote"
            data-ga-event="cta_click"
            data-ga-label="hero_get_quote"
          >
            Get a free quote
          </a>
        </div>
        <div class="flex flex-wrap justify-center gap-2 text-[0.68rem] font-medium text-ink-soft sm:justify-start sm:text-xs">
          <span class="rounded-full border border-border bg-white/90 px-3 py-1.5 leading-none">Owner-operated</span>
          <span class="rounded-full border border-border bg-white/90 px-3 py-1.5 leading-none">Reply within 1 hour</span>
          <span class="rounded-full border border-border bg-white/90 px-3 py-1.5 leading-none">Residential only</span>
        </div>
        <div id="hero-sentinel" class="h-1"></div>
      </div>
      <div class="relative z-10 hidden animate-rise xl:block" style="animation-delay: 150ms">
        <div class="glass relative overflow-hidden rounded-[2rem] border border-white/60 p-5 shadow-soft">
          <div class="absolute right-6 top-6 h-24 w-24 rounded-full border border-ink/10 bg-sage/30"></div>
          <div class="absolute bottom-8 right-16 h-40 w-40 rounded-full border border-ink/10 bg-clay/15"></div>
          <div class="relative space-y-5">
            <div class="rounded-2xl border border-border/80 bg-white/88 p-5">
              <p class="section-kicker">This week</p>
              <h2 class="mt-2 text-3xl">Fast-turn curb appeal work</h2>
              <p class="mt-3 text-sm text-ink-soft">
                Text a few photos, your area, and timing. We will confirm the practical next step.
              </p>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div class="rounded-2xl border border-border bg-paper/75 p-4">
                <p class="text-3xl font-display leading-none">1 hr</p>
                <p class="mt-2 text-xs uppercase tracking-[0.22em] text-ink-soft">Typical reply window</p>
              </div>
              <div class="rounded-2xl border border-border bg-paper/75 p-4">
                <p class="text-3xl font-display leading-none">Local</p>
                <p class="mt-2 text-xs uppercase tracking-[0.22em] text-ink-soft">Owner-operated and residential</p>
              </div>
            </div>
            <div class="rounded-2xl border border-border bg-white/88 p-5 text-sm">
              <p class="font-semibold text-ink">Best-fit jobs right now</p>
              <div class="mt-3 flex flex-wrap gap-2 text-xs text-ink-soft">
                <span class="rounded-full border border-border bg-paper px-3 py-1">Fence refresh</span>
                <span class="rounded-full border border-border bg-paper px-3 py-1">Rock work</span>
                <span class="rounded-full border border-border bg-paper px-3 py-1">Power washing</span>
                <span class="rounded-full border border-border bg-paper px-3 py-1">Mulch top-up</span>
              </div>
            </div>
            <a
              class="btn-primary w-full px-6 py-3"
              href={business.smsHref}
              data-ga-event="cta_click"
              data-ga-label="hero_snapshot_text_photos"
            >
              Text photos for a quote
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section pt-2 sm:pt-0 lg:hidden">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine">
        <p class="section-kicker">Quick service snapshot</p>
        <h2 class="text-2xl">What you can expect</h2>
        <ul class="mt-4 space-y-2 text-sm text-ink-soft">
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 rounded-full bg-ink/70"></span>
            Clear communication, on-time arrivals, and a tidy finish.
          </li>
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 rounded-full bg-ink/70"></span>
            Reply within 1 hour during work hours.
          </li>
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 rounded-full bg-ink/70"></span>
            Priority services this week: fences, rock work, mulching, and power washing.
          </li>
        </ul>
        <div class="mt-4 rounded-xl border border-border bg-paper/70 p-4 text-sm text-ink-soft">
          <p class="font-semibold text-ink">What to send for a fast quote</p>
          <ul class="mt-2 space-y-1">
            <li>- Your area or neighborhood</li>
            <li>- The service needed and a couple of photos if you have them</li>
            <li>- When you want it done</li>
          </ul>
        </div>
        <div class="mt-4 rounded-xl border border-ink/10 bg-white/80 p-4 text-sm">
          <p class="font-semibold text-ink">Local trust proof</p>
          <ul class="mt-2 space-y-1 text-ink-soft">
            {homepageTrustProof.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <a
          class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-ink hover:text-ink/70"
          href="#quote"
          data-ga-event="cta_click"
          data-ga-label="snapshot_mobile_request_quote"
        >
          Request your quote
          <span aria-hidden="true">-&gt;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section pt-2 sm:pt-0 content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="grid gap-6 rounded-[2rem] border border-border bg-white/92 p-6 shadow-soft sm:p-8 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="space-y-3">
          <p class="section-kicker">Why homeowners feel comfortable reaching out</p>
          <h2 class="text-2xl font-display sm:text-3xl">Clear communication, practical scope, and real proof.</h2>
          <p class="text-sm leading-7 text-ink-soft">
            We do not rely on flashy promises. The goal is to make it easy to understand what fits,
            what happens next, and why the finished result should feel worth it.
          </p>
          <div class="flex flex-wrap gap-2 text-xs text-ink-soft">
            {homepageTrustProof.map((item) => (
              <span class="rounded-full border border-border bg-paper px-3 py-1.5">{item}</span>
            ))}
          </div>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          {homepageTrustMoments.map((item) => (
            <article class="rounded-2xl border border-border bg-paper/55 p-5">
              <p class="text-base font-semibold text-ink">{item.title}</p>
              <p class="mt-2 text-sm text-ink-soft">{item.detail}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section pt-2 sm:pt-0 content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="grid gap-6 rounded-[2rem] border border-border bg-white/90 p-6 shadow-fine sm:p-8 lg:grid-cols-[1fr_0.95fr] lg:items-center">
        <div class="space-y-3">
          <p class="section-kicker">Reviews and reputation</p>
          <h2 class="text-2xl font-display sm:text-3xl">Want to sanity-check us first?</h2>
          <p class="text-sm leading-7 text-ink-soft">
            That is completely fair. You can read reviews, see the way we ask for feedback, and get a
            feel for how we handle homeowner communication before you ever request a quote.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              class="rounded-full bg-ink px-6 py-3 text-sm font-semibold text-paper hover:bg-ink/90"
              href={business.reviewLinks.google}
              target="_blank"
              rel="noreferrer"
              data-ga-event="cta_click"
              data-ga-label="homepage_reviews_google"
            >
              Read Google reviews
            </a>
            <a
              class="rounded-full border border-ink/20 px-6 py-3 text-sm font-semibold hover:border-ink"
              href="/review"
              data-ga-event="cta_click"
              data-ga-label="homepage_review_page"
            >
              See how feedback works
            </a>
          </div>
        </div>
        <div class="rounded-2xl border border-ink/10 bg-paper/70 p-5 sm:p-6">
          <p class="text-xs uppercase tracking-[0.24em] text-ink-soft">What homeowners usually care about</p>
          <ul class="mt-4 space-y-3 text-sm text-ink-soft">
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-ink/70"></span>
              Will the job feel straightforward from quote to cleanup?
            </li>
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-ink/70"></span>
              Will the property be treated carefully and left tidy?
            </li>
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-ink/70"></span>
              Will someone be honest if a simpler fix makes more sense?
            </li>
          </ul>
          <p class="mt-4 text-sm font-semibold text-ink">
            Those are exactly the trust points we try to make obvious early.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="gallery" class="section content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-6 sm:mb-10">
        <div class="space-y-3">
          <p class="section-kicker">Service examples</p>
          <h2 class="section-title">A few examples of the clean, finished look we aim for.</h2>
        </div>
        <p class="section-copy max-w-md">
          We only share photos we have permission to use, with details kept general when needed.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {galleryItems.map((item, index) => (
          <div
            class="group overflow-hidden rounded-2xl border border-border bg-white/90 shadow-fine animate-rise"
            style={`animation-delay: ${index * 80}ms`}
          >
            <div class="relative aspect-[4/3] overflow-hidden bg-paper/80">
              <img
                src={item.image}
                alt={item.alt}
                width="600"
                height="450"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
                sizes="(min-width: 1024px) 31vw, (min-width: 640px) 48vw, 100vw"
              />
            </div>
            <div class="p-5">
              <p class="text-sm font-semibold text-ink">{item.label}</p>
              <p class="mt-1 text-xs text-ink-soft">Shared with permission.</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section pt-2 sm:pt-0 content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-6 sm:mb-10">
        <div class="space-y-3">
          <p class="section-kicker">Project types</p>
          <h2 class="section-title">Scope that goes beyond basic cleanup.</h2>
        </div>
        <a
          class="text-sm font-semibold text-ink hover:text-ink/70"
          href="/projects"
          data-ga-event="cta_click"
          data-ga-label="homepage_project_types"
        >
          See all project profiles -&gt;
        </a>
      </div>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {projectProfiles.map((project, index) => (
          <article
            class="rounded-2xl border border-border bg-white/90 p-5 shadow-fine animate-rise"
            style={`animation-delay: ${index * 70}ms`}
          >
            <p class="text-lg font-semibold">{project.title}</p>
            <p class="mt-2 text-sm text-ink-soft">{project.summary}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {project.relatedServiceHrefs.slice(0, 2).map((related) => (
                <a
                  href={related.href}
                  class="rounded-full border border-border bg-paper px-3 py-1 text-xs text-ink-soft transition hover:border-ink/30 hover:text-ink"
                >
                  {related.label}
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="services" class="section content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-6 sm:mb-10">
        <div class="space-y-3">
          <p class="section-kicker">Services</p>
          <h2 class="section-title">Everything your yard needs to look its best.</h2>
        </div>
        <p class="section-copy max-w-md">
          We handle both recurring maintenance and larger exterior projects. That includes lawns, planting
          areas, mulching, brush clearing, power washing, rock work, driveway grading, and gravel driveway upgrades.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {serviceCatalog.map((service, index) => (
          <a
            href={`/services/${service.slug}`}
            class="lift-card group p-6 animate-rise"
            style={`animation-delay: ${index * 60}ms`}
          >
            <div class="mb-5 flex items-center justify-between gap-4">
              <span class="service-mark">{String(index + 1).padStart(2, "0")}</span>
              <span class="h-px flex-1 bg-border"></span>
            </div>
            <p class="text-base font-semibold">{service.name}</p>
            <p class="mt-2 text-sm text-ink-soft">{service.description}</p>
            <p class="mt-3 text-sm font-semibold text-ink group-hover:text-ink/70">View service -&gt;</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section content-auto">
    <div class="mx-auto grid max-w-6xl gap-8 px-5 sm:gap-10 sm:px-6 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="space-y-4">
        <p class="section-kicker">Book-now offers</p>
        <h2 class="section-title">Fast bookings this week.</h2>
        <p class="section-copy">
          These are the fastest-turn services we are pushing right now to fill nearby routes.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {homepagePackages.map((item, index) => (
          <div class="rounded-2xl border border-border bg-white/85 p-6 animate-rise" style={`animation-delay: ${index * 80}ms`}>
            <p class="text-lg font-semibold">{item.name}</p>
            <p class="text-sm text-ink-soft">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="grid gap-6 rounded-[2rem] border border-border bg-white/85 p-7 shadow-soft sm:gap-8 sm:p-9 lg:grid-cols-3 lg:p-10">
        <div class="space-y-3">
          <p class="section-kicker">How it works</p>
          <h2 class="section-title text-2xl sm:text-3xl">A simple process from start to finish.</h2>
        </div>
        <div class="space-y-4">
          <div class="rounded-xl border border-border bg-white/90 p-5 shadow-fine">
            <p class="text-sm font-semibold">1. Reach out</p>
            <p class="text-sm text-ink-soft">Call, text, or send the form with a few details.</p>
          </div>
          <div class="rounded-xl border border-border bg-white/90 p-5 shadow-fine">
            <p class="text-sm font-semibold">2. Quick quote</p>
            <p class="text-sm text-ink-soft">We confirm scope, timing, and a clear price.</p>
          </div>
          <div class="rounded-xl border border-border bg-white/90 p-5 shadow-fine">
            <p class="text-sm font-semibold">3. We show up</p>
            <p class="text-sm text-ink-soft">You get a tidy, cared-for yard you can relax in.</p>
          </div>
        </div>
        <div class="grid-dots rounded-xl border border-ink/10 p-4 text-sm text-ink-soft">
          <p class="font-semibold text-ink">Fast replies</p>
          <p>We aim to reply within 1 hour during work hours.</p>
          <p class="mt-3 font-semibold text-ink">Service area</p>
          <p>Lower-mid Vancouver Island.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section pt-2 sm:pt-0 content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="mb-6 space-y-3 sm:mb-10">
        <p class="section-kicker">Service standards</p>
        <h2 class="section-title">What you can count on, even before photos or reviews.</h2>
        <p class="section-copy max-w-3xl">
          We keep the process transparent and consistent so you know exactly what to expect on every
          visit.
        </p>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        {homepageTrustSignals.map((item, index) => (
          <article
            class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine animate-rise"
            style={`animation-delay: ${index * 70}ms`}
          >
            <p class="text-base font-semibold text-ink">{item.title}</p>
            <p class="mt-2 text-sm text-ink-soft">{item.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section pt-2 sm:pt-0 content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-6 sm:mb-10">
        <div class="space-y-3">
          <p class="section-kicker">Typical outcomes</p>
          <h2 class="section-title">Results homeowners usually ask us to create.</h2>
        </div>
        <a
          class="text-sm font-semibold text-ink hover:text-ink/70"
          href="/quote"
          data-ga-event="cta_click"
          data-ga-label="outcomes_request_quote"
        >
          Request a quote -&gt;
        </a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {homepageOutcomeHighlights.map((item, index) => (
          <article
