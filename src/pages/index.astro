---
import Layout from "../components/Layout.astro";
import QuoteForm from "../components/QuoteForm.astro";
import { business } from "../data/business";
import {
  homepageFaqs,
  homepageServiceAreas,
  homepageServiceHighlights,
  homepageTrustMoments,
  homepageTrustProof,
} from "../data/homepage";
import { locations } from "../data/locations";
import { services as serviceCatalog } from "../data/services";
import {
  createFAQSchema,
  createHomepageBusinessSchema,
  createOrganizationSchema,
  createServiceSchema,
  createWebsiteSchema,
} from "../lib/schema";

const pageTitle = "Landscaping & Property Maintenance | Maestros Services";
const metaDescription =
  "Owner-operated landscaping and property maintenance across lower-mid Vancouver Island, including gutters, roof moss, pressure washing, fences and cleanups.";
const canonicalUrl = `${business.siteUrl}${Astro.url.pathname}`;

const structuredData = [
  createFAQSchema(homepageFaqs),
  createHomepageBusinessSchema(homepageServiceAreas, homepageServiceHighlights, metaDescription),
  createOrganizationSchema(),
  createWebsiteSchema(),
  ...serviceCatalog.map((service) => createServiceSchema(service)),
];

const heroImageMobile = "/responsive/garden-640.webp";
const heroImageMobileWide = "/responsive/garden-768.webp";
const heroImageTablet = "/responsive/garden-960.webp";
const heroImagePhoneRetina = "/responsive/garden-1125.webp";
const heroImageDesktop = "/responsive/garden-1280.webp";
const heroImageFallback = "/garden.webp";

const featuredServiceSlugs = [
  "gutter-cleaning",
  "moss-algae-treatment",
  "pressure-washing",
  "fence-work-minor-repairs",
] as const;

const featuredServices = featuredServiceSlugs.flatMap((slug) =>
  serviceCatalog.filter((service) => service.slug === slug),
);

const galleryItems = [
  {
    kind: "image",
    label: "Finished stone path",
    image: "/work/path-after-dog-640.webp",
    srcSet: "/work/path-after-dog-640.webp 640w",
    sizes: "(max-width: 639px) 82vw, (max-width: 1023px) 24rem, 22rem",
    width: 900,
    height: 675,
    alt: "Finished stepping-stone path with a dog standing on the pavers",
    detail: "A finished stepping-stone path connecting the house and shed.",
  },
  {
    kind: "image",
    label: "Where it started",
    image: "/work/path-before-01-640.webp",
    srcSet: "/work/path-before-01-640.webp 640w",
    sizes: "(max-width: 639px) 82vw, (max-width: 1023px) 24rem, 22rem",
    width: 900,
    height: 675,
    alt: "Bare garden track leading to the shed before the path was laid",
    detail: "The same garden before the path was dug out and the stones were laid.",
  },
  {
    kind: "image",
    label: "Laying pavers by hand",
    image: "/work/path-during-kneeling-640.webp",
    srcSet: "/work/path-during-kneeling-640.webp 640w",
    sizes: "(max-width: 639px) 82vw, (max-width: 1023px) 24rem, 22rem",
    width: 900,
    height: 675,
    alt: "Josh kneeling to place a paver on the new stone path",
    detail: "Josh placing and levelling the stones, one at a time.",
  },
  {
    kind: "cta",
    label: "Ready to request a quote?",
    detail:
      "Send a couple of photos, your area, and timing. We will reply with the practical next step.",
    ctaHref: "#quote",
  },
] as const;

const featuredAreaLinks = locations.slice(0, 12).map((location) => ({
  name: location.name,
  href: `/areas/${location.slug}`,
}));

const hiddenAreaCount = Math.max(locations.length - featuredAreaLinks.length, 0);
---

<Layout
  title={pageTitle}
  description={metaDescription}
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
  quoteHref="#quote"
  headerVariant="simple"
  mobileStickyHeader={true}
  showMobileCTA={false}
  showDesktopCTA={false}
  preloadImages={[
    {
      href: heroImageMobileWide,
      type: "image/webp",
      media: "(max-width: 767px)",
      fetchPriority: "high",
    },
    {
      href: heroImageTablet,
      type: "image/webp",
      media: "(min-width: 768px) and (max-width: 1023px)",
      fetchPriority: "high",
    },
    {
      href: heroImageDesktop,
      type: "image/webp",
      media: "(min-width: 1024px)",
      fetchPriority: "high",
    },
  ]}
  analytics={{
    pageGroup: "homepage",
    pageType: "home",
    pageTemplate: "home",
  }}
>
  <section class="relative isolate h-[calc(100dvh-3.75rem)] overflow-hidden pb-0 mb-0 md:h-[calc(100svh-5rem)] md:mb-10 md:pb-6 lg:h-[calc(100svh-4.5rem)] lg:mb-0 lg:pb-0">
    <div class="absolute inset-0">
      <img
          src={heroImageFallback}
          srcset={`${heroImageMobile} 640w, ${heroImageMobileWide} 768w, ${heroImageTablet} 960w, ${heroImagePhoneRetina} 1125w, ${heroImageDesktop} 1280w, ${heroImageFallback} 1600w`}
          sizes="100vw"
          alt="Clean front yard with fresh landscaping and neat garden beds"
          class="h-full w-full object-cover object-[center_28%] sm:object-[center_34%] lg:object-center"
          width="1280"
          height="960"
          loading="eager"
          fetchpriority="high"
          decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-br from-ink/70 via-ink/35 to-ink/10"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_20%,rgba(255,255,255,0.1),transparent_38%),radial-gradient(circle_at_80%_30%,rgba(255,255,255,0.08),transparent_36%),linear-gradient(180deg,transparent,rgba(0,0,0,0.18))]"></div>
      <div class="absolute right-[11%] top-[45%] z-10 hidden -translate-y-1/2 flex-col items-center gap-4 md:flex lg:right-[14%] xl:right-[16%]">
        <div class="flex size-64 items-center justify-center rounded-full border border-white/60 bg-white/92 shadow-soft backdrop-blur-sm">
          <img
            src="/logo.webp?v=1"
            alt="Maestros Services logo"
            class="h-36 w-36 object-contain"
            width="305"
            height="294"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="text-center font-sans text-[1.95rem] font-semibold leading-none tracking-[0.025em] whitespace-nowrap text-white drop-shadow-[0_2px_14px_rgba(0,0,0,0.9)] sm:text-[2.3rem]">
          Maestros Services
        </div>
      </div>
      <div class="absolute bottom-[4rem] left-1/2 z-10 flex -translate-x-1/2 flex-col items-center gap-1.5 sm:hidden">
        <div class="flex size-32 items-center justify-center rounded-full border border-white/60 bg-white/88 shadow-soft backdrop-blur-sm">
          <img
            src="/logo.webp?v=1"
            alt=""
            aria-hidden="true"
            class="h-20 w-20 object-contain"
            width="305"
            height="294"
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="w-max rounded-full border border-white/50 bg-white/78 px-3 py-1.5 text-center text-[0.56rem] font-semibold uppercase leading-none tracking-[0.12em] whitespace-nowrap text-ink shadow-soft backdrop-blur-sm">
          Maestros Property Maintenance & Landscaping
        </div>
      </div>
    </div>

    <div class="relative z-20 mx-auto flex h-full max-w-6xl items-start px-4 pb-5 pt-16 sm:px-6 sm:pb-10 sm:pt-24 lg:items-center lg:px-8 lg:py-0 lg:translate-y-6">
      <div class="max-w-xl animate-rise lg:max-w-[38rem] xl:max-w-[40rem] lg:-translate-x-10 xl:-translate-x-14">
        <div class="rounded-[2rem] border border-white/25 bg-white/86 p-3 shadow-soft backdrop-blur-xl sm:p-8 lg:p-7 xl:p-8">
          <div class="hidden flex-wrap items-center gap-3 sm:flex">
            <div class="rounded-full border border-ink/10 bg-white/90 px-3 py-1 text-[0.66rem] font-semibold uppercase tracking-[0.3em] text-ink-soft">
              Owner-operated across lower-mid Vancouver Island
            </div>
            <div class="rounded-full border border-ink/10 bg-white/90 px-3 py-1 text-[0.66rem] font-semibold uppercase tracking-[0.3em] text-ink-soft">
              Residential only
            </div>
          </div>
          <p class="mt-3 hidden text-[0.68rem] font-medium uppercase tracking-[0.28em] text-ink-soft sm:block">
            Call or text Josh directly
          </p>
          <h1 class="mt-3 max-w-xl text-[1.82rem] font-display leading-[0.92] tracking-tight text-ink text-balance sm:text-5xl lg:text-[3.05rem] xl:text-[3.2rem]">
            Gutter cleaning and property care for your home.
          </h1>
          <p class="mt-2 hidden max-w-lg text-[0.86rem] leading-[1.45] text-ink-soft sm:mt-4 sm:block sm:text-lg sm:leading-7">
            Serving Victoria, Langford, Saanich, Mill Bay, Duncan, and nearby communities. Send a photo, your area, and timing for the practical next step.
          </p>
          <div class="mt-4 flex flex-col gap-2 sm:mt-6 sm:flex-row sm:flex-wrap sm:items-center">
            <a
              class="btn-primary w-full px-6 py-2 text-center shadow-fine sm:w-auto sm:px-8 sm:py-4"
              href={`tel:${business.phoneTel}`}
              data-ga-event="cta_click"
              data-ga-label="hero_call_text"
            >
              Call Josh
            </a>
            <a
              class="btn-secondary w-full px-6 py-2 text-center sm:w-auto sm:px-8 sm:py-4"
              href="#quote"
              data-ga-event="cta_click"
              data-ga-label="hero_get_quote"
            >
              Get a quote
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="gutter-heading" class="section pb-0">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="surface-card grid overflow-hidden md:grid-cols-2">
        <figure class="m-0 bg-paper">
          <img
            src="/work/gutter-clogged-closeup-640.webp"
            alt="Leaves and needles built up in a gutter beside the roof edge"
            class="aspect-[4/3] w-full object-cover"
            width="675"
            height="900"
            loading="lazy"
            decoding="async"
          />
          <figcaption class="px-6 py-3 text-sm text-ink-soft">Gutter debris from a Maestros Services job.</figcaption>
        </figure>
        <div class="flex flex-col justify-center p-6 sm:p-8">
          <p class="section-kicker">Gutter cleaning</p>
          <h2 id="gutter-heading" class="section-title mt-3">Leaves and needles collecting in your gutters?</h2>
          <p class="section-copy mt-4">Send Josh a photo, your area, and a note about access. He can review what is needed and discuss the scope, timing, and quote with you.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a class="btn-primary px-6 py-3 text-center" href={business.smsHref} data-ga-event="cta_click" data-ga-label="home_gutter_text_photos">Text Josh photos</a>
            <a class="btn-secondary px-6 py-3 text-center" href="/services/gutter-cleaning/" data-ga-event="cta_click" data-ga-label="home_gutter_details">Gutter cleaning details</a>
          </div>
          <a class="mt-4 text-sm font-semibold underline decoration-ink/30" href="#quote">Or request a quote online</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section mt-0 pt-4 sm:mt-10 sm:pt-10 lg:mt-10 lg:pt-10 content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="grid gap-4 md:grid-cols-3">
        {homepageTrustMoments.map((item, index) => (
          <article
            class="rounded-[1.75rem] border border-border bg-white/92 p-6 shadow-fine animate-rise"
            style={`animation-delay: ${index * 70}ms`}
          >
            <p class="section-kicker">{item.title}</p>
            <p class="mt-3 text-sm leading-7 text-ink-soft">{item.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="services" class="section content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-6 sm:mb-8">
        <div class="space-y-3">
          <p class="section-kicker">Featured services</p>
          <h2 class="section-title">Services homeowners ask us about most.</h2>
        </div>
        <p class="section-copy max-w-md">
          Practical exterior and yard work with straightforward quote discussions and direct contact with the owner.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {featuredServices.map((service, index) => (
          <a
            href={`/services/${service.slug}`}
            class="lift-card group p-6 animate-rise"
            style={`animation-delay: ${index * 60}ms`}
          >
            <div class="mb-5 flex items-center justify-between gap-4">
              <span class="service-mark">{String(index + 1).padStart(2, "0")}</span>
              <span class="h-px flex-1 bg-border"></span>
            </div>
            <p class="text-base font-semibold">{service.name}</p>
            <p class="mt-2 text-sm leading-7 text-ink-soft">{service.description}</p>
            <p class="mt-4 text-sm font-semibold text-ink group-hover:text-ink/70">See service details -&gt;</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="gallery" class="section bg-transparent pb-0">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-6 sm:mb-8">
        <div class="space-y-3">
          <p class="section-kicker">Recent work</p>
          <h2 class="section-title">A garden path, from start to finish.</h2>
        </div>
          <p class="section-copy max-w-md text-ink/80">
            The finished path, where it started, and the work along the way. Photos from one of our recent jobs.
          </p>
      </div>
      <div class="gallery-rail flex snap-x snap-mandatory gap-4 overflow-x-auto pb-0 sm:-mx-6 sm:px-6 lg:mx-0 lg:px-0" role="region" aria-label="Path project photos" tabindex="0">
        {galleryItems.map((item, index) => (
          <article
            class="gallery-card group min-w-[82vw] snap-start overflow-hidden rounded-[1.75rem] border border-transparent bg-transparent shadow-none sm:min-w-[24rem] lg:min-w-[22rem] animate-rise"
            style={`animation-delay: ${index * 70}ms`}
          >
            {"image" in item ? (
              <>
                <div class="relative aspect-[4/3] overflow-hidden bg-transparent">
                  <img
                    src={item.image}
                    srcset={item.srcSet}
                    sizes={item.sizes}
                    alt={item.alt}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    width={item.width}
                    height={item.height}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                  <div class="border-t border-ink/6 bg-paper/45 px-5 py-5 sm:px-6 sm:py-6">
                    <p class="text-sm font-semibold text-ink">{item.label}</p>
                    <p class="mt-2 text-sm leading-7 text-ink/80">{item.detail}</p>
                  </div>
              </>
            ) : (
              <div class="flex h-full min-h-[24rem] flex-col justify-between px-2 py-5 sm:px-2 sm:py-6">
                <div>
                  <p class="section-kicker">Need a quick quote?</p>
                  <h3 class="mt-3 text-2xl font-display text-ink">{item.label}</h3>
                  <p class="mt-4 text-sm leading-7 text-ink-soft">{item.detail}</p>
                </div>
                <a
                  class="btn-primary mt-6 w-full px-5 py-3 text-center sm:w-auto"
                  href={item.ctaHref}
                  data-ga-event="cta_click"
                  data-ga-label="gallery_quote_prompt"
                >
                  Get a quote
                </a>
              </div>
            )}
          </article>
        ))}
      </div>
      <a class="mt-6 inline-flex min-h-11 items-center text-sm font-semibold text-ink underline underline-offset-4" href="/stepping-stone-paths" data-ga-event="cta_click" data-ga-label="homepage_path_story">
        See the full path project <span aria-hidden="true" class="ml-2">→</span>
      </a>
    </div>
  </section>

  <section class="section content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="grid gap-6 rounded-[2rem] border border-border bg-white/92 p-6 shadow-soft sm:p-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
        <div class="space-y-3">
          <p class="section-kicker">Reviews and reputation</p>
          <h2 class="text-2xl font-display sm:text-3xl">Want to get a feel for the work before you reach out?</h2>
          <p class="text-sm leading-7 text-ink-soft">
            Fair enough. You can read reviews, see how we ask for feedback, and get a feel for our
            communication before you request a quote.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              class="rounded-full bg-ink px-6 py-3 text-sm font-semibold text-paper hover:bg-ink/90"
              href={business.reviewLinks.googleRead}
              target="_blank"
              rel="noreferrer"
              data-ga-event="cta_click"
              data-ga-label="homepage_reviews_google"
            >
              Read Google reviews
            </a>
            <a
              class="rounded-full border border-ink/20 px-6 py-3 text-sm font-semibold hover:border-ink"
              href="/review"
              data-ga-event="cta_click"
              data-ga-label="homepage_review_page"
            >
              See how feedback works
            </a>
          </div>
        </div>
        <div class="rounded-[1.5rem] border border-ink/10 bg-paper/70 p-5 sm:p-6">
          <p class="text-xs uppercase tracking-[0.24em] text-ink-soft">What homeowners usually want to know</p>
          <ul class="mt-4 space-y-3 text-sm text-ink-soft">
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-ink/70"></span>
              Is the process straightforward from quote to cleanup?
            </li>
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-ink/70"></span>
              Will the property be treated carefully and left tidy?
            </li>
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 rounded-full bg-ink/70"></span>
              Will someone be honest if a simpler fix makes more sense?
            </li>
          </ul>
          <p class="mt-4 text-sm font-semibold text-ink">
            We try to make those answers obvious early.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="service-area" class="section content-auto">
    <div class="mx-auto grid max-w-6xl gap-8 px-5 sm:gap-10 sm:px-6 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="space-y-4">
        <p class="section-kicker">Service area</p>
        <h2 class="section-title">Serving lower-mid Vancouver Island.</h2>
        <p class="section-copy">
          Based near Shawnigan Lake and serving nearby communities across the lower-mid island. If you are close by, ask
          and we will confirm availability.
        </p>
        <a class="text-sm font-semibold text-ink hover:text-ink/70" href="/service-area" data-ga-event="cta_click" data-ga-label="service_area_page">
          See all areas we cover -&gt;
        </a>
        <div class="flex flex-wrap gap-3 text-sm text-ink-soft">
          {featuredAreaLinks.map((area) => (
            <a
              href={area.href}
              class="rounded-full border border-border bg-white/90 px-4 py-1 transition hover:border-ink/30 hover:text-ink"
            >
              {area.name}
            </a>
          ))}
          <a
            href="/service-area"
            class="rounded-full border border-ink/20 bg-paper px-4 py-1 font-semibold text-ink transition hover:border-ink"
          >
            {hiddenAreaCount > 0 ? `+ ${hiddenAreaCount} more areas` : "View service area"}
          </a>
        </div>
      </div>
      <div class="space-y-5">
        <div class="rounded-[1.75rem] border border-border bg-white/92 p-6 shadow-fine">
          <p class="section-kicker">Local map</p>
          <h3 class="text-xl sm:text-2xl">Coverage map</h3>
          <div class="mt-5 flex items-center justify-center rounded-[1.5rem] border border-border bg-white p-5 text-ink/80">
            <picture class="block w-full">
              <source srcset="/VIMAP.svg?v=2" type="image/svg+xml" />
              <img
                src="/VIMAP.png?v=2"
                alt="Map of lower-mid Vancouver Island service area"
                width="400"
                height="256"
                class="mx-auto h-56 w-auto max-w-full rounded-xl object-contain sm:h-64"
                loading="lazy"
                decoding="async"
                sizes="(min-width: 1024px) 26rem, 100vw"
              />
            </picture>
          </div>
        </div>
        <div class="rounded-[1.75rem] border border-border bg-white/92 p-6 shadow-fine">
          <p class="section-kicker">Direct quote path</p>
          <h3 class="text-2xl">Ready to discuss a quote? Call or text.</h3>
          <div class="mt-5 space-y-3 text-sm">
            <a
              class="block rounded-xl bg-ink px-4 py-3 text-center font-semibold text-paper hover:bg-ink/90"
              href={`tel:${business.phoneTel}`}
              data-ga-event="cta_click"
              data-ga-label="service_area_call"
            >
              {business.phone}
            </a>
            <a
              class="block rounded-xl border border-ink/15 bg-white/90 px-4 py-3 text-center hover:border-ink"
              href={`mailto:${business.email}`}
              data-ga-event="cta_click"
              data-ga-label="service_area_email"
            >
              {business.email}
            </a>
          </div>
          <p class="mt-4 text-xs uppercase tracking-[0.3em] text-ink-soft">Residential only</p>
        </div>
      </div>
    </div>
  </section>

  <section id="faq" class="section content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="mb-6 space-y-3 sm:mb-8">
        <p class="section-kicker">FAQ</p>
        <h2 class="section-title">Common questions.</h2>
      </div>
      <div class="grid gap-4 lg:grid-cols-2">
        {homepageFaqs.map((faq, index) => (
          <div
            class="rounded-[1.5rem] border border-border bg-white/92 p-6 shadow-fine animate-rise"
            style={`animation-delay: ${index * 60}ms`}
          >
            <p class="text-base font-semibold">{faq.question}</p>
            <p class="mt-2 text-sm leading-7 text-ink-soft">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="quote" class="section content-auto">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <QuoteForm showInfoBox={true} />
    </div>
  </section>
</Layout>
