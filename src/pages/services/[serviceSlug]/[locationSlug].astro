---
import Layout from "../../../components/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import QuoteForm from "../../../components/QuoteForm.astro";
import { business } from "../../../data/business";
import type { Location } from "../../../data/locations";
import { getLocationById } from "../../../data/locations";
import type { Service } from "../../../data/services";
import { serviceLocationPages, hasServiceLocationPage, getServiceLocationPagesForLocation } from "../../../data/serviceLocationPages";
import {
  createBreadcrumbSchema,
  createFAQSchema,
  createServiceLocationSchema,
} from "../../../lib/schema";

export async function getStaticPaths() {
  return serviceLocationPages.map((entry) => ({
    params: {
      serviceSlug: entry.service.slug,
      locationSlug: entry.location.slug,
    },
    props: {
      service: entry.service,
      location: entry.location,
    },
  }));
}

const { service, location } = Astro.props as {
  service: Service;
  location: Location;
};
const isDrivewayService =
  service.slug === "driveway-grading" || service.slug === "gravel-driveway-installation";

const locationSeoOverrides: Record<string, { title: string; description: string }> = {
  "power-washing": {
    title: `Power Washing and Pressure Washing in ${location.name}, BC | ${business.name}`,
    description: `Power washing and pressure washing in ${location.name}, BC for driveways, patios, decks, walkways, and exterior surfaces. Fast residential quotes, careful cleaning, and tidy cleanup.`,
  },
  "driveway-grading": {
    title: `Driveway Grading in ${location.name}, BC | ${business.name}`,
    description: `Driveway grading in ${location.name}, BC for ruts, puddles, washboarding, and uneven gravel surfaces. Homeowners here get fast quotes, clearer runoff, and practical residential service.`,
  },
  "gravel-driveway-installation": {
    title: `Gravel Driveway Preparation and Refresh in ${location.name}, BC | ${business.name}`,
    description: `Gravel driveway preparation, fresh aggregate, and driveway refresh work in ${location.name}, BC. Clean edges, better drainage, and practical residential quotes for worn or patchy gravel surfaces.`,
  },
};

const locationServiceSeoOverrides: Record<string, { title: string; description: string }> = {
  "gravel-driveway-installation:chemainus": {
    title: `Gravel Driveway Preparation in Chemainus, BC | Refresh and Base Prep`,
    description:
      "Gravel driveway preparation in Chemainus, BC for soft spots, puddles, edge breakdown, and patchy gravel surfaces. Practical base prep, refresh work, and fast residential quotes.",
  },
  "driveway-grading:chemainus": {
    title: `Driveway Grading in Chemainus, BC | Fix Puddles, Ruts, and Washboarding`,
    description:
      "Driveway grading in Chemainus, BC for puddles, ruts, washboarding, and uneven gravel surfaces. Better runoff, smoother access, and practical residential service.",
  },
};

const seoKey = `${service.slug}:${location.slug}`;

const pageTitle =
  locationServiceSeoOverrides[seoKey]?.title ??
  locationSeoOverrides[service.slug]?.title ??
  `${service.shortName} in ${location.name}, BC | ${business.name}`;
const pageDescription =
  locationServiceSeoOverrides[seoKey]?.description ??
  locationSeoOverrides[service.slug]?.description ??
  `${service.name} in ${location.name}, BC. ${service.description} Homeowners here get fast quotes, clear communication, and tidy cleanup from start to finish.`;
const canonicalUrl = `${business.siteUrl}/services/${service.slug}/${location.slug}`;

const breadcrumbItems = [
  { name: "Services", href: "/services" },
  { name: service.shortName, href: `/services/${service.slug}` },
  { name: location.name, href: `/services/${service.slug}/${location.slug}` },
];

const pageHeading =
  seoKey === "gravel-driveway-installation:chemainus"
    ? "Gravel Driveway Preparation in Chemainus"
    : `${service.shortName} in ${location.name}`;

const pageFaqs = [
  {
    question: `Do you offer ${service.shortName.toLowerCase()} in ${location.name}?`,
    answer: `Yes. ${business.name} provides ${service.shortName.toLowerCase()} for homeowners in ${location.name} and nearby neighborhoods.`,
  },
];

if (!isDrivewayService) {
  pageFaqs.push(
    {
      question: `How often should I book ${service.shortName.toLowerCase()} in ${location.name}?`,
      answer: `Most properties book during ${service.seasonalRelevance.join(", ")}. We can recommend a weekly, bi-weekly, or seasonal schedule based on your yard.`,
    },
    {
      question: `Can I combine ${service.shortName.toLowerCase()} with other services in ${location.name}?`,
      answer: `Absolutely. Many homeowners bundle this service with recurring maintenance, garden bed care, and seasonal cleanup visits.`,
    },
  );
}

if (service.slug === "gravel-driveway-installation") {
  pageFaqs.push({
    question: `What does gravel driveway preparation usually include in ${location.name}?`,
    answer: `Most gravel driveway prep in ${location.name} starts with checking the base, correcting soft or thin areas, improving the surface shape for runoff, and getting the driveway ready for fresh aggregate where needed.`,
  });

  if (location.slug === "chemainus") {
    pageFaqs.push({
      question: "Can you refresh only the entrance or worst section of a gravel driveway in Chemainus?",
      answer:
        "Often, yes. Some Chemainus driveways mainly need the entrance, parking area, or another high-wear section brought back up. We can review photos and tell you whether a partial refresh will hold up well or whether a broader pass makes more sense.",
    });
  }
}

if (service.slug === "driveway-grading") {
  pageFaqs.push({
    question: `Can driveway grading fix puddles and washboarding in ${location.name}?`,
    answer: `Often, yes. If the driveway still has enough usable material, grading can restore shape, improve runoff, and reduce repeat low spots without jumping straight to a full rebuild.`,
  });

  if (location.slug === "chemainus") {
    pageFaqs.push({
      question: "Do repeat puddles on a Chemainus gravel driveway usually mean I need more gravel?",
      answer:
        "Not always. In Chemainus, repeat puddles often mean the surface shape, crown, or runoff path needs correction first. If the material is still usable overall, grading can be the better first step before adding more gravel.",
    });
  }
}

if (service.slug === "power-washing") {
  pageFaqs.push({
    question: `Do you clean decks, patios, and driveways in ${location.name}?`,
    answer: `Yes. Power washing requests in ${location.name} often include driveways, patios, walkways, decks, and fences. We review the material first and use the right cleaning approach for each surface.`,
  });
}

const structuredData = [
  createServiceLocationSchema(service, location),
  createBreadcrumbSchema(breadcrumbItems),
  createFAQSchema(pageFaqs),
];

const nearbyPages = location.nearbyAreas
  .map((id) => getLocationById(id))
  .filter((nearby): nearby is Location => Boolean(nearby))
  .filter((nearby) => hasServiceLocationPage(service.id, nearby.id))
  .map((nearby) => ({
    name: nearby.name,
    href: `/services/${service.slug}/${nearby.slug}`,
  }));

const relatedServicePages = getServiceLocationPagesForLocation(location.id)
  .filter((entry) => entry.service.id !== service.id)
  .map((entry) => ({
    name: entry.service.shortName,
    href: entry.href,
    description: entry.service.description,
  }));

const neighborhoodList = location.neighborhoods?.slice(0, 6) ?? [];
const landmarkList = location.localLandmarks?.slice(0, 4) ?? [];

const serviceGoalById: Record<Service["id"], string> = {
  "lawn-mowing": "a consistently clean lawn with less weekly effort",
  "hedge-trimming": "clean lines and healthy regrowth between seasons",
  "garden-bed-maintenance": "weed suppression and stronger curb appeal",
  "seasonal-cleanups": "a cleaner reset before weather shifts",
  "weed-control": "longer gaps between regrowth cycles",
  "yard-waste-removal": "faster post-project cleanup",
  "brush-clearing": "safer and more usable outdoor space",
  "gutter-cleaning-ground-access": "cleaner drainage flow and less overflow risk",
  "light-pruning": "cleaner plant shape with healthy seasonal growth",
  "moss-algae-treatment": "safer, cleaner hard surfaces in wet seasons",
  "fence-work-minor-repairs": "a cleaner, straighter perimeter with better everyday function",
  "power-washing": "cleaner hard surfaces and stronger curb appeal",
  "rock-work-walls": "a cleaner property layout with stronger visual structure",
  "driveway-grading": "better driveway access and fewer drainage issues",
  "gravel-driveway-installation": "a stronger, cleaner driveway surface",
};

const normalizeFeature = (feature: string) =>
  feature.charAt(0).toLowerCase() + feature.slice(1).replace(/\.$/, "");

const primaryNeighborhood = neighborhoodList[0] ?? location.name;
const primaryLandmark = landmarkList[0] ?? `${location.name} town core`;
const seasonNames = service.seasonalRelevance.map(
  (season) => season.charAt(0).toUpperCase() + season.slice(1)
);
const seasonSummary =
  seasonNames.length > 1
    ? `${seasonNames.slice(0, -1).join(", ")} and ${seasonNames[seasonNames.length - 1]}`
    : seasonNames[0] ?? "all seasons";
const relatedServiceSummary = relatedServicePages
  .slice(0, 2)
  .map((entry) => entry.name.toLowerCase())
  .join(" and ");
const serviceGoal = serviceGoalById[service.id];
const isChemainusDrivewayCluster =
  location.slug === "chemainus" &&
  (service.slug === "driveway-grading" || service.slug === "gravel-driveway-installation");

const localizedHeroNote = isChemainusDrivewayCluster
  ? service.slug === "gravel-driveway-installation"
    ? "This page is built for Chemainus homeowners comparing driveway preparation, fresh gravel, and partial refresh work when the surface feels thin, soft, or patchy."
    : "This page is built for Chemainus homeowners dealing with puddles, ruts, washboarding, and uneven gravel surfaces who want to know if grading is enough before paying for a bigger refresh."
  : null;

const localProofItems = isDrivewayService
  ? [
      {
        title: `Common request in ${location.name}`,
        detail: `Requests here usually involve preparation, a surface refresh, or grading when the driveway is thin, rutted, holding water, or breaking down at the edges.`,
      },
      {
        title: `${location.name} seasonal pattern`,
        detail: `${service.shortName} work here is strongest in ${seasonSummary}. Scheduling stays flexible around local weather windows.`,
      },
      {
        title: "What helps a quote",
        detail:
          "Photos of the full driveway plus the worst section are usually enough to tell whether a smaller repair, a refresh, or a broader pass makes sense.",
      },
    ]
  : [
      {
        title: `Common request in ${primaryNeighborhood}`,
        detail: `Around ${primaryLandmark}, homeowners usually ask for ${normalizeFeature(service.features[0])} to keep properties tidy with minimal disruption.`,
      },
      {
        title: `${location.name} seasonal pattern`,
        detail: `${service.shortName} bookings here are strongest in ${seasonSummary}. We keep scheduling flexible around local weather windows.`,
      },
      {
        title: `Typical bundled scope`,
        detail: relatedServiceSummary
          ? `Many quotes in ${location.name} combine this with ${relatedServiceSummary} for ${serviceGoal}.`
          : `Many quotes in ${location.name} combine this with general yard upkeep for ${serviceGoal}.`,
      },
    ];

const serviceFormMap: Record<string, string> = {
  "lawn-mowing": "mowing",
  "hedge-trimming": "trim",
  "garden-bed-maintenance": "mulch",
  "seasonal-cleanups": "cleanup",
  "weed-control": "other",
  "yard-waste-removal": "other",
  "brush-clearing": "other",
  "gutter-cleaning-ground-access": "gutter",
  "light-pruning": "pruning",
  "moss-algae-treatment": "moss",
  "fence-work-minor-repairs": "fence",
  "power-washing": "powerwash",
  "rock-work-walls": "rock",
  "driveway-grading": "driveway",
  "gravel-driveway-installation": "gravel",
};

const localTrustPoints = [
  `You are reaching the owner directly for ${service.shortName.toLowerCase()} in ${location.name}.`,
  "If a smaller fix, different service, or another trade makes more sense, we would rather tell you that early.",
  "You can read reviews first, check the review page, and then decide if you want to contact us.",
] as const;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
  headerVariant="simple"
  headerSubtitle={pageHeading}
  quoteHref="#quote"
  analytics={{
    pageGroup: "service_location_pages",
    pageType: "service_location",
    pageTemplate: "service-location",
  }}
>
  <section class="section">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <Breadcrumbs items={breadcrumbItems} />

      <div class="mb-10 space-y-4">
        <p class="section-kicker">{location.region}</p>
        <h1 class="section-title">{pageHeading}</h1>
        <p class="section-copy max-w-3xl">
          {service.longDescription} Homeowners in {location.name} trust us for consistent, friendly
          service and clear communication from quote to cleanup.
        </p>
        {
          localizedHeroNote && (
            <div class="max-w-3xl rounded-2xl border border-border bg-paper/65 px-4 py-3 text-sm text-ink-soft">
              {localizedHeroNote}
            </div>
          )
        }
        <div class="flex flex-wrap gap-2 text-[0.68rem] uppercase tracking-[0.2em] text-ink-soft">
          <span class="rounded-full border border-border bg-paper px-3 py-1.5">Residential only</span>
          <span class="rounded-full border border-border bg-paper px-3 py-1.5">Fast quotes</span>
          <span class="rounded-full border border-border bg-paper px-3 py-1.5">Tidy cleanup</span>
        </div>
      </div>

      <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr]">
        <div class="space-y-8">
          <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine sm:p-8">
            <p class="section-kicker">What is included</p>
            <h2 class="mb-4 text-2xl font-display font-semibold text-ink sm:text-3xl">
              {service.shortName} visit checklist
            </h2>
            <ul class="space-y-3">
              {
                service.features.map((feature) => (
                  <li class="flex gap-3 text-sm text-ink-soft">
                    <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-ink/70" />
                    {feature}
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine sm:p-8">
            <p class="section-kicker">Local focus</p>
            <h2 class="mb-4 text-2xl font-display font-semibold text-ink sm:text-3xl">
              Service details for {location.name}
            </h2>
            <p class="mb-5 text-sm leading-relaxed text-ink-soft">
              We schedule around local weather, lot sizes, and neighborhood access patterns in {location.name}
              so the work feels smooth, the communication stays clear, and the final result looks
              professional without extra hassle.
            </p>

            {
              neighborhoodList.length > 0 && (
                <div class="mb-5">
                  <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-ink-soft">
                    Neighborhoods we regularly serve
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {neighborhoodList.map((name) => (
                      <span class="rounded-full border border-border bg-paper px-3 py-1 text-xs text-ink-soft">
                        {name}
                      </span>
                    ))}
                  </div>
                </div>
              )
            }

            {
              landmarkList.length > 0 && (
                <div>
                  <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-ink-soft">
                    Local landmarks
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {landmarkList.map((name) => (
                      <span class="rounded-full border border-border bg-paper px-3 py-1 text-xs text-ink-soft">
                        {name}
                      </span>
                    ))}
                  </div>
                </div>
              )
            }
          </div>

          <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine sm:p-8">
            <p class="section-kicker">Local proof</p>
            <h2 class="mb-4 text-2xl font-display font-semibold text-ink sm:text-3xl">
              What homeowners ask for in {location.name}
            </h2>
            <div class="grid gap-4 sm:grid-cols-3">
              {
                localProofItems.map((item) => (
                  <article class="rounded-xl border border-border bg-paper/60 p-4">
                    <h3 class="text-sm font-semibold text-ink">{item.title}</h3>
                    <p class="mt-2 text-xs leading-relaxed text-ink-soft">{item.detail}</p>
                  </article>
                ))
              }
            </div>
          </div>

          {
            service.beforeAfterScenarios && service.beforeAfterScenarios.length > 0 && (
              <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine sm:p-8">
                <p class="section-kicker">Before and after</p>
                <h2 class="mb-6 text-2xl font-display font-semibold text-ink sm:text-3xl">
                  {service.slug === "gravel-driveway-installation"
                    ? "Typical gravel driveway outcomes"
                    : service.slug === "driveway-grading"
                      ? "Typical driveway grading outcomes"
                      : `${service.shortName} outcomes in ${location.name}`}
                </h2>
                <div class="grid gap-4">
                  {service.beforeAfterScenarios.map((scenario) => (
                    <article class="grid gap-3 rounded-xl border border-border bg-paper/60 p-4 sm:grid-cols-3">
                      <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ink-soft">
                          Before
                        </p>
                        <p class="mt-1 text-sm text-ink-soft">{scenario.before}</p>
                      </div>
                      <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ink-soft">
                          After
                        </p>
                        <p class="mt-1 text-sm text-ink-soft">{scenario.after}</p>
                      </div>
                      <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ink-soft">
                          Result
                        </p>
                        <p class="mt-1 text-sm text-ink">{scenario.result}</p>
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            )
          }

          <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine sm:p-8">
            <p class="section-kicker">Common questions</p>
            <h2 class="mb-6 text-2xl font-display font-semibold text-ink sm:text-3xl">
              {service.shortName} FAQs for {location.name}
            </h2>
            <div class="space-y-5">
              {
                pageFaqs.map((faq) => (
                  <div class="border-b border-border pb-5 last:border-0 last:pb-0">
                    <h3 class="mb-2 text-sm font-semibold text-ink">{faq.question}</h3>
                    <p class="text-sm leading-relaxed text-ink-soft">{faq.answer}</p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <div class="space-y-6 lg:sticky lg:top-6 lg:self-start">
          <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine">
            <p class="section-kicker">Nearby areas</p>
            <h2 class="mb-4 text-xl font-display font-semibold text-ink sm:text-2xl">
              {service.shortName} near {location.name}
            </h2>
            {
              nearbyPages.length > 0 ? (
                <div class="flex flex-wrap gap-2">
                  {nearbyPages.map((nearby) => (
                    <a
                      href={nearby.href}
                      class="rounded-full border border-border bg-paper px-4 py-2 text-sm text-ink-soft transition hover:border-ink/30 hover:text-ink"
                    >
                      {nearby.name}
                    </a>
                  ))}
                </div>
              ) : (
                <p class="text-sm text-ink-soft">
                  Also available across Greater Victoria and the Cowichan Valley.
                </p>
              )
            }
          </div>

          <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine">
            <p class="section-kicker">More in {location.name}</p>
            <h2 class="mb-4 text-xl font-display font-semibold text-ink sm:text-2xl">
              Related services
            </h2>
            <div class="space-y-3">
              {
                relatedServicePages.map((related) => (
                  <a
                    href={related.href}
                    class="block rounded-xl border border-border bg-paper/50 p-4 transition hover:border-ink/30"
                  >
                    <p class="text-sm font-semibold text-ink">{related.name}</p>
                    <p class="mt-1 text-xs leading-relaxed text-ink-soft">
                      {related.description}
                    </p>
                  </a>
                ))
              }
            </div>
          </div>

          <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine">
            <p class="section-kicker">Get a quote</p>
            <h2 class="mb-2 text-xl font-display font-semibold text-ink sm:text-2xl">
              Book {service.shortName.toLowerCase()}
            </h2>
            <p class="mb-4 text-sm text-ink-soft">
              Call or text for the fastest response. We usually reply within 1 hour during work hours.
            </p>
            <div class="space-y-3 text-sm">
              <a
                class="block rounded-xl border border-ink/15 bg-white/90 px-4 py-3 text-center hover:border-ink"
                href={`tel:${business.phoneTel}`}
                data-ga-event="cta_click"
                data-ga-label={`service_location_${service.slug}_${location.slug}_call`}
              >
                {business.phone}
              </a>
              <a
                class="block rounded-xl border border-ink/15 bg-white/90 px-4 py-3 text-center hover:border-ink"
                href={`mailto:${business.email}`}
                data-ga-event="cta_click"
                data-ga-label={`service_location_${service.slug}_${location.slug}_email`}
              >
                {business.email}
              </a>
              <a
                class="block rounded-xl bg-ink px-4 py-3 text-center font-semibold text-paper hover:bg-ink/90"
                href="#quote"
                data-ga-event="cta_click"
                data-ga-label={`service_location_${service.slug}_${location.slug}_quote`}
              >
                Get a free quote
              </a>
            </div>
          </div>

          <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine">
            <p class="section-kicker">Check trust first</p>
            <h2 class="mb-3 text-xl font-display font-semibold text-ink sm:text-2xl">
              A low-pressure way to vet us
            </h2>
            <ul class="space-y-3 text-sm text-ink-soft">
              {localTrustPoints.map((point) => (
                <li class="flex gap-3">
                  <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-ink/70" />
                  {point}
                </li>
              ))}
            </ul>
            <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
              <a
                class="rounded-full bg-ink px-5 py-3 text-center text-sm font-semibold text-paper hover:bg-ink/90"
                href={business.reviewLinks.google}
                target="_blank"
                rel="noreferrer"
                data-ga-event="cta_click"
                data-ga-label={`service_location_${service.slug}_${location.slug}_google_reviews`}
              >
                Read Google reviews
              </a>
              <a
                class="rounded-full border border-ink/20 px-5 py-3 text-center text-sm font-semibold hover:border-ink"
                href="/review"
                data-ga-event="cta_click"
                data-ga-label={`service_location_${service.slug}_${location.slug}_review_page`}
              >
                See our review page
              </a>
            </div>
          </div>

          {
            isDrivewayService && (
              <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine">
                <p class="section-kicker">Driveway help</p>
                <h2 class="mb-2 text-xl font-display font-semibold text-ink sm:text-2xl">
                  Driveway FAQ
                </h2>
                <p class="mb-4 text-sm text-ink-soft">
                  Review common questions about grading, gravel refreshes, and drainage fixes.
                </p>
                <a
                  class="inline-flex items-center gap-2 text-sm font-semibold text-ink hover:text-ink/70"
                  href="/driveway-faq"
                >
                  Open driveway FAQ -&gt;
                </a>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section id="quote" class="section">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="mb-8 space-y-3">
        <p class="section-kicker">Request a quote</p>
        <h2 class="section-title">
          Get {service.shortName.toLowerCase()} in {location.name}
        </h2>
        <p class="text-sm text-ink-soft">
          Need a faster response? Call or text{" "}
          <a
            class="font-semibold text-ink hover:text-ink/70"
            href={`tel:${business.phoneTel}`}
            data-ga-event="cta_click"
            data-ga-label={`service_location_${service.slug}_${location.slug}_quote_section_call`}
          >
            {business.phone}
          </a>
          .
        </p>
      </div>
      <QuoteForm
        preselectedService={serviceFormMap[service.slug] || "other"}
        preselectedArea={location.name}
        showInfoBox={true}
      />
    </div>
  </section>
</Layout>
