---
import Layout from "../../components/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import QuoteForm from "../../components/QuoteForm.astro";
import { business } from "../../data/business";
import { services, getServiceById } from "../../data/services";
import { locations } from "../../data/locations";
import { getServiceLocationPagesForService } from "../../data/serviceLocationPages";
import {
  createServiceSchema,
  createBreadcrumbSchema,
  createFAQSchema,
} from "../../lib/schema";

export async function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const relatedServices = service.relatedServices
  .map((id) => getServiceById(id))
  .filter(Boolean);
const isDrivewayService =
  service.slug === "driveway-grading" || service.slug === "gravel-driveway-installation";

const localizedServicePages = getServiceLocationPagesForService(service.id);

const serviceSpecifics: Record<
  string,
  {
    bestFitTitle: string;
    bestFitPoints: string[];
    notFitTitle: string;
    notFitPoints: string[];
    quoteChecklist: string[];
    reassurance: string;
    trustPoints: string[];
  }
> = {
  "power-washing": {
    bestFitTitle: "Best fit when hard surfaces are making the property feel older than it is.",
    bestFitPoints: [
      "Driveways, patios, entries, or walkways look dark, slippery, or weathered.",
      "You want a fast curb-appeal reset before summer, guests, or listing photos.",
      "You want the surface cleaned carefully without using the same pressure everywhere.",
    ],
    notFitTitle: "Usually not the best fit when the issue is structural, not just surface-level.",
    notFitPoints: [
      "The concrete, pavers, decking, or siding already has damage that needs repair first.",
      "You need a stain, seal, repaint, or full restoration rather than cleaning alone.",
      "The goal is only to remove a permanent mark that may not fully lift with washing.",
    ],
    quoteChecklist: [
      "1 to 3 photos of the surface and any slippery or stained areas",
      "Your location and whether it is driveway, patio, walkway, fence, or siding",
      "Whether the priority is appearance, safety, or pre-listing cleanup",
    ],
    reassurance:
      "We check the material first, adjust pressure to the surface, and leave the area tidy when we are done.",
    trustPoints: [
      "We do not treat every surface the same way just to move faster.",
      "We will tell you plainly if a gentler wash, treatment, or different service makes more sense.",
      "Nearby plants, edges, and transitions get a rinse-down and cleanup pass as part of the job.",
    ],
  },
  "fence-work-minor-repairs": {
    bestFitTitle: "Best fit for practical fence fixes that improve function and first impression.",
    bestFitPoints: [
      "A gate is sagging, hardware is loose, or a section looks out of line.",
      "The fence line feels messy because of overgrowth, leaning sections, or wear.",
      "You want a clear answer on whether the issue is a quick repair or a larger rebuild.",
    ],
    notFitTitle: "Usually not the best fit for full replacement or major structural rebuild work.",
    notFitPoints: [
      "Large portions of the fence are failing or the whole run needs replacement.",
      "The job needs engineered plans, permits, or a full new-build scope.",
      "Access conditions or hidden rot mean the practical answer is a bigger rebuild.",
    ],
    quoteChecklist: [
      "Photos of the problem section, gate, hinges, latch, or fence line",
      "Your location and roughly how many sections are affected",
      "Whether access is straightforward and if cleanup around the fence is also needed",
    ],
    reassurance:
      "If the job falls outside minor repair scope, we will say so clearly and point you toward the right next step.",
    trustPoints: [
      "We focus on practical, homeowner-friendly repair scope instead of overselling a full rebuild.",
      "If a simple adjustment will solve the issue, we would rather tell you that than pad the job.",
      "Fence-line cleanup and better access often make the finished result feel much more complete.",
    ],
  },
  "garden-bed-maintenance": {
    bestFitTitle: "Best fit when beds need a visible refresh without a full landscape rebuild.",
    bestFitPoints: [
      "Mulch has thinned out, edges are soft, or weeds are getting ahead of you.",
      "You want the front yard to look cleaner fast with less weekly upkeep.",
      "You want a practical bed refresh that works with the plants already there.",
    ],
    notFitTitle: "Usually not the best fit when the real need is redesign, replanting, or irrigation work.",
    notFitPoints: [
      "You want a full landscape redesign with new layout, plant selection, and installation.",
      "Drainage, irrigation, or dead plant replacement is the main issue.",
      "The bed needs construction-level changes rather than cleanup, edging, and mulch refresh.",
    ],
    quoteChecklist: [
      "Photos of the beds, edges, and any problem areas",
      "Your location and whether you want bark mulch, wood chips, decorite, or are open to recommendations",
      "Whether the priority is curb appeal, weed control, or a general seasonal reset",
    ],
    reassurance:
      "We can recommend a practical material option based on the look you want, your budget, and how much upkeep you want later.",
    trustPoints: [
      "We can explain the tradeoff between cleaner look, lower upkeep, and material cost.",
      "If the existing bed only needs a tidy-up and top-up, we are happy to keep it simple.",
      "The goal is a finished look that still makes sense for how much maintenance you want later.",
    ],
  },
  "seasonal-cleanups": {
    bestFitTitle: "Best fit when the whole yard needs a practical reset, not just one small fix.",
    bestFitPoints: [
      "Leaves, debris, overgrowth, or leftover seasonal mess are making the property feel behind.",
      "You want the yard brought back under control before guests, listing photos, or a season change.",
      "You would rather handle the reset in one visit than patch it together over several smaller jobs.",
    ],
    notFitTitle: "Usually not the best fit when you only need one quick maintenance task.",
    notFitPoints: [
      "The real need is regular mowing only, one hedge trim, or one isolated small service.",
      "You need ongoing weekly maintenance rather than a spring or fall reset.",
      "The job is mostly construction debris, non-yard material, or waste outside normal green cleanup scope.",
    ],
    quoteChecklist: [
      "Photos of the front yard, backyard, and any areas that are most overgrown or debris-heavy",
      "Your location and whether this is a spring reset, fall cleanup, or general catch-up visit",
      "Whether you also want haul-away, gutter cleaning, pruning, or bed cleanup included",
    ],
    reassurance:
      "If a simpler service bundle makes more sense than a full cleanup visit, we will tell you that directly.",
    trustPoints: [
      "We look at the whole property so the cleanup feels coordinated instead of piecemeal.",
      "You get a clearer sense of what is included before the visit starts.",
      "Cleanup, bag-up, and a tidy finish are part of why homeowners book this service in the first place.",
    ],
  },
  "driveway-grading": {
    bestFitTitle: "Best fit when the driveway still has enough material but the shape and drainage are off.",
    bestFitPoints: [
      "You are seeing ruts, washboarding, puddles, or uneven travel lines after rain or regular vehicle use.",
      "You want smoother access and better runoff without jumping straight to a full rebuild.",
      "You want a practical reset that improves daily use and helps the driveway look more cared for from the road.",
    ],
    notFitTitle: "Usually not the best fit when the driveway needs a bigger rebuild or all-new material.",
    notFitPoints: [
      "The existing surface is too thin, contaminated, or broken down for grading alone to hold.",
      "The driveway needs major excavation, major drainage reconstruction, or a new install.",
      "The real issue is missing gravel volume rather than only poor shaping or crown.",
    ],
    quoteChecklist: [
      "Photos showing ruts, puddles, soft spots, and the overall run of the driveway",
      "Your location and an approximate driveway length or number of problem areas",
      "Whether the priority is smoother driving, better drainage, or a cleaner entrance look",
    ],
    reassurance:
      "If fresh gravel, a larger refresh, or another driveway option makes more sense than grading alone, we will tell you before the job moves ahead.",
    trustPoints: [
      "We focus on practical results like runoff, drivability, and surface hold, not just making it look freshly disturbed.",
      "We are happy to say when grading alone is enough and when it is not.",
      "The goal is fewer repeat trouble spots, not a temporary cosmetic pass.",
    ],
  },
  "gravel-driveway-installation": {
    bestFitTitle: "Best fit when the driveway needs more than reshaping and would benefit from a stronger refresh or install.",
    bestFitPoints: [
      "The surface is thin, patchy, or inconsistent from years of piecemeal top-ups.",
      "You want cleaner edges, better aggregate coverage, and a more finished entrance look.",
      "You want a practical small-to-mid-size driveway upgrade that improves use and appearance together.",
    ],
    notFitTitle: "Usually not the best fit for very large engineered driveway builds or specialty paving.",
    notFitPoints: [
      "The scope needs stamped engineering, major excavation, or a full civil-style build.",
      "You are deciding between asphalt, concrete, and several non-gravel surfaces first.",
      "The property access, grade, or drainage demands a much larger construction solution.",
    ],
    quoteChecklist: [
      "Photos of the full driveway run, entrance, and any thin or soft sections",
      "Your location and whether this is a refresh, top-up, partial rebuild, or new gravel section",
      "Any known issues with tracking, washout, drainage, or edge breakdown",
    ],
    reassurance:
      "If grading, a smaller refresh, or another simpler fix would solve the problem well enough, we will tell you instead of forcing a larger scope.",
    trustPoints: [
      "We care about base condition, edge definition, and usable finish, not just dumping more gravel.",
      "You get a clearer explanation of where new material helps and where prep matters more.",
      "A cleaner driveway entrance can make the whole property feel better cared for right away.",
    ],
  },
};

const serviceSpecific =
  serviceSpecifics[service.slug] ?? {
    bestFitTitle: `Best fit for homeowners who want ${service.shortName.toLowerCase()} done cleanly and without guesswork.`,
    bestFitPoints: [
      "You want a straightforward quote and a tidy finish.",
      "You want a practical next step based on the actual condition of the property.",
      "You prefer owner-operated residential service over a drawn-out sales process.",
    ],
    notFitTitle: "Not every property issue needs the most complicated service.",
    notFitPoints: [
      "If there is a simpler or more appropriate next step, we will point you there.",
      "If your scope is outside residential-friendly service, we will say so clearly.",
      "If another trade or specialty is a better fit, we would rather be direct about that.",
    ],
    quoteChecklist: [
      "Your location and the service you need",
      "A few photos if you have them",
      "Your preferred timing or any access details that matter",
    ],
    reassurance:
      "If there is a better or simpler next step than the one you first asked about, we will tell you plainly.",
    trustPoints: [
      "Clear scope before work starts.",
      "Straightforward communication about what makes sense and what does not.",
      "Owner-operated service with a tidy finish and respectful cleanup.",
    ],
  };

const pageTitle = `Residential ${service.shortName} on Vancouver Island | ${business.name}`;
const pageDescription = `${service.description} Residential service across lower-mid Vancouver Island with clear communication, fast quotes, and a clean finish.`;
const canonicalUrl = `${business.siteUrl}/services/${service.slug}`;

const breadcrumbItems = [
  { name: "Services", href: "/services" },
  { name: service.shortName, href: `/services/${service.slug}` },
];

const structuredData = [
  createServiceSchema(service),
  createBreadcrumbSchema(breadcrumbItems),
  createFAQSchema(service.faqs),
];

// Map service to form value
const serviceFormMap: Record<string, string> = {
  "lawn-mowing": "mowing",
  "hedge-trimming": "trim",
  "garden-bed-maintenance": "mulch",
  "seasonal-cleanups": "cleanup",
  "weed-control": "other",
  "yard-waste-removal": "other",
  "brush-clearing": "other",
  "gutter-cleaning-ground-access": "gutter",
  "light-pruning": "pruning",
  "moss-algae-treatment": "moss",
  "fence-work-minor-repairs": "fence",
  "power-washing": "powerwash",
  "rock-work-walls": "rock",
  "driveway-grading": "driveway",
  "gravel-driveway-installation": "gravel",
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  structuredData={structuredData}
  headerVariant="simple"
  headerSubtitle={service.shortName}
  quoteHref="#quote"
  analytics={{
    pageGroup: "service_pages",
    pageType: "service_page",
    pageTemplate: "service",
  }}
>
  <section class="section">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <Breadcrumbs items={breadcrumbItems} />

      <div class="mb-10 space-y-4">
        <p class="section-kicker">Our services</p>
        <h1 class="section-title">{service.name}</h1>
        <p class="section-copy max-w-3xl">
          {service.longDescription} Homeowners choose this service when they want reliable
          scheduling, straightforward pricing, and a clean wrap-up from a residential crew.
        </p>
        <div class="flex flex-wrap gap-2 text-[0.68rem] uppercase tracking-[0.2em] text-ink-soft">
          <span class="rounded-full border border-border bg-paper px-3 py-1.5">Residential only</span>
          <span class="rounded-full border border-border bg-paper px-3 py-1.5">Fast quotes</span>
          <span class="rounded-full border border-border bg-paper px-3 py-1.5">Tidy cleanup</span>
        </div>
      </div>

      <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr]">
        <div class="space-y-8">
          <!-- Features -->
          <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine sm:p-8 content-auto">
            <p class="section-kicker">What's included</p>
            <h2 class="mb-4 text-2xl font-display font-semibold text-ink sm:text-3xl">
              {service.shortName} features
            </h2>
            <ul class="space-y-3">
              {
                service.features.map((feature) => (
                  <li class="flex gap-3 text-sm text-ink-soft">
                    <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-ink/70" />
                    {feature}
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Seasonal Relevance -->
          <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine sm:p-8">
            <p class="section-kicker">Best times</p>
            <h2 class="mb-4 text-2xl font-display font-semibold text-ink sm:text-3xl">
              When to schedule
            </h2>
            <p class="mb-4 text-sm leading-relaxed text-ink-soft">
              This service is typically available and most beneficial during these seasons on
              Vancouver Island:
            </p>
            <div class="flex flex-wrap gap-2">
              {
                service.seasonalRelevance.map((season) => (
                  <span class="rounded-full border border-border bg-paper px-4 py-2 text-sm text-ink capitalize">
                    {season}
                  </span>
                ))
              }
            </div>
          </div>

          {
            service.beforeAfterScenarios && service.beforeAfterScenarios.length > 0 && (
              <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine sm:p-8 content-auto">
                <p class="section-kicker">Before and after</p>
                <h2 class="mb-6 text-2xl font-display font-semibold text-ink sm:text-3xl">
                  Typical {service.shortName.toLowerCase()} outcomes
                </h2>
                <div class="grid gap-4">
                  {service.beforeAfterScenarios.map((scenario) => (
                    <article class="grid gap-3 rounded-xl border border-border bg-paper/60 p-4 sm:grid-cols-3">
                      <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ink-soft">
                          Before
                        </p>
                        <p class="mt-1 text-sm text-ink-soft">{scenario.before}</p>
                      </div>
                      <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ink-soft">
                          After
                        </p>
                        <p class="mt-1 text-sm text-ink-soft">{scenario.after}</p>
                      </div>
                      <div>
                        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ink-soft">
                          Result
                        </p>
                        <p class="mt-1 text-sm text-ink">{scenario.result}</p>
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            )
          }

          <!-- FAQs -->
          <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine sm:p-8 content-auto">
            <p class="section-kicker">Common questions</p>
            <h2 class="mb-6 text-2xl font-display font-semibold text-ink sm:text-3xl">
              {service.shortName} FAQs
            </h2>
            <div class="space-y-5">
              {
                service.faqs.map((faq) => (
                  <div class="border-b border-border pb-5 last:border-0 last:pb-0">
                    <h3 class="mb-2 text-sm font-semibold text-ink">{faq.question}</h3>
                    <p class="text-sm leading-relaxed text-ink-soft">{faq.answer}</p>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Related Services -->
          {
            relatedServices.length > 0 && (
              <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine sm:p-8 content-auto">
                <p class="section-kicker">You might also need</p>
                <h2 class="mb-4 text-2xl font-display font-semibold text-ink sm:text-3xl">
                  Related services
                </h2>
                <div class="grid gap-4 sm:grid-cols-2">
                  {relatedServices.map((related) => (
                    <a
                      href={`/services/${related!.slug}`}
                      class="group rounded-xl border border-border bg-paper/50 p-4 transition hover:border-ink/30"
                    >
                      <h3 class="text-sm font-semibold text-ink group-hover:text-ink/80">
                        {related!.shortName}
                      </h3>
                      <p class="mt-1 text-xs leading-relaxed text-ink-soft">
                        {related!.description.slice(0, 80)}...
                      </p>
                    </a>
                  ))}
                </div>
              </div>
            )
          }
        </div>

        <!-- Sidebar -->
        <div class="space-y-6 lg:sticky lg:top-6 lg:self-start">
          <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine">
            <p class="section-kicker">Service areas</p>
            <h2 class="mb-4 text-xl font-display font-semibold text-ink sm:text-2xl">
              Where we offer this
            </h2>
            <p class="mb-4 text-sm text-ink-soft">
              We provide {service.shortName.toLowerCase()} services throughout lower-mid
              Vancouver Island, from Victoria to Duncan.
            </p>
            {
              localizedServicePages.length > 0 ? (
                <>
                  <div class="flex flex-wrap gap-2">
                    {localizedServicePages.slice(0, 8).map((entry) => (
                      <a
                        href={entry.href}
                        class="rounded-full border border-border bg-paper px-3 py-1 text-xs text-ink-soft transition hover:border-ink/30 hover:text-ink"
                      >
                        {entry.location.name}
                      </a>
                    ))}
                  </div>
                  <a
                    href="/services-by-area"
                    class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-ink hover:text-ink/70"
                  >
                    See all {localizedServicePages.length} localized pages -&gt;
                  </a>
                </>
              ) : (
                <div class="flex flex-wrap gap-2">
                  {
                    locations.slice(0, 8).map((location) => (
                      <a
                        href={`/areas/${location.slug}`}
                        class="rounded-full border border-border bg-paper px-3 py-1 text-xs text-ink-soft transition hover:border-ink/30 hover:text-ink"
                      >
                        {location.name}
                      </a>
                    ))
                  }
                  <a
                    href="/service-area"
                    class="rounded-full border border-ink/20 bg-paper px-3 py-1 text-xs text-ink hover:border-ink"
                  >
                    + {locations.length - 8} more
                  </a>
                </div>
              )
            }
          </div>

          <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine">
            <p class="section-kicker">Good fit</p>
            <h2 class="mb-3 text-xl font-display font-semibold text-ink sm:text-2xl">
              {serviceSpecific.bestFitTitle}
            </h2>
            <ul class="space-y-3 text-sm text-ink-soft">
              {serviceSpecific.bestFitPoints.map((point) => (
                <li class="flex gap-3">
                  <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-ink/70" />
                  {point}
                </li>
              ))}
            </ul>
          </div>

          <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine">
            <p class="section-kicker">Honest fit check</p>
            <h2 class="mb-3 text-xl font-display font-semibold text-ink sm:text-2xl">
              {serviceSpecific.notFitTitle}
            </h2>
            <ul class="space-y-3 text-sm text-ink-soft">
              {serviceSpecific.notFitPoints.map((point) => (
                <li class="flex gap-3">
                  <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-ink/70" />
                  {point}
                </li>
              ))}
            </ul>
          </div>

          <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine">
            <p class="section-kicker">Why homeowners use us</p>
            <h2 class="mb-3 text-xl font-display font-semibold text-ink sm:text-2xl">
              Practical, owner-operated service
            </h2>
            <ul class="space-y-3 text-sm text-ink-soft">
              {serviceSpecific.trustPoints.map((point) => (
                <li class="flex gap-3">
                  <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-ink/70" />
                  {point}
                </li>
              ))}
            </ul>
          </div>

          <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine">
            <p class="section-kicker">Get in touch</p>
            <h2 class="mb-2 text-xl font-display font-semibold text-ink sm:text-2xl">
              Request {service.shortName.toLowerCase()}
            </h2>
            <p class="mb-4 text-sm text-ink-soft">
              Call or text for the fastest response. We typically reply within 1 hour during work hours.
            </p>
            <div class="space-y-3 text-sm">
              <a
                class="block rounded-xl border border-ink/15 bg-white/90 px-4 py-3 text-center hover:border-ink"
                href={`tel:${business.phoneTel}`}
                data-ga-event="cta_click"
                data-ga-label={`service_${service.slug}_call`}
              >
                {business.phone}
              </a>
              <a
                class="block rounded-xl border border-ink/15 bg-white/90 px-4 py-3 text-center hover:border-ink"
                href={`mailto:${business.email}`}
                data-ga-event="cta_click"
                data-ga-label={`service_${service.slug}_email`}
              >
                {business.email}
              </a>
              <a
                class="block rounded-xl bg-ink px-4 py-3 text-center font-semibold text-paper hover:bg-ink/90"
                href="#quote"
                data-ga-event="cta_click"
                data-ga-label={`service_${service.slug}_quote`}
              >
                Get a free quote
              </a>
            </div>
            <p class="mt-4 text-xs text-ink-soft">
              {serviceSpecific.reassurance}
            </p>
          </div>

          <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine">
            <p class="section-kicker">Fast quote prep</p>
            <h2 class="mb-3 text-xl font-display font-semibold text-ink sm:text-2xl">
              What helps us quote faster
            </h2>
            <ul class="space-y-3 text-sm text-ink-soft">
              {serviceSpecific.quoteChecklist.map((item) => (
                <li class="flex gap-3">
                  <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-ink/70" />
                  {item}
                </li>
              ))}
            </ul>
          </div>

          {
            isDrivewayService && (
              <div class="rounded-2xl border border-border bg-white/90 p-6 shadow-fine">
                <p class="section-kicker">Need quick answers?</p>
                <h2 class="mb-2 text-xl font-display font-semibold text-ink sm:text-2xl">
                  Driveway FAQ
                </h2>
                <p class="mb-4 text-sm text-ink-soft">
                  Compare grading vs gravel refresh, drainage fixes, timelines, and quote prep.
                </p>
                <a
                  class="inline-flex items-center gap-2 text-sm font-semibold text-ink hover:text-ink/70"
                  href="/driveway-faq"
                >
                  Open driveway FAQ -&gt;
                </a>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Quote Form Section -->
  <section id="quote" class="section">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
      <div class="mb-8 space-y-3">
        <p class="section-kicker">Request a quote</p>
        <h2 class="section-title">Get {service.shortName.toLowerCase()} service</h2>
        <p class="text-sm text-ink-soft">
          Prefer phone? Call or text{" "}
          <a
            class="font-semibold text-ink hover:text-ink/70"
            href={`tel:${business.phoneTel}`}
            data-ga-event="cta_click"
            data-ga-label={`service_${service.slug}_quote_section_call`}
          >
            {business.phone}
          </a>
          . For faster quoting, send photos plus your area and ideal timing if you have them.
        </p>
      </div>
      <QuoteForm
        preselectedService={serviceFormMap[service.slug] || "other"}
        showInfoBox={true}
      />
    </div>
  </section>
</Layout>
