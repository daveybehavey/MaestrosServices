---
import { business } from "../data/business";

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  preloadImages?: Array<{
    href: string;
    type?: string;
    media?: string;
    srcSet?: string;
    sizes?: string;
    fetchPriority?: "high" | "low" | "auto";
  }>;
  ogImage?: string;
  ogType?: "website" | "article";
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    author: string;
    tags?: string[];
  };
  noindex?: boolean;
  structuredData?: object | object[];
  analytics?: {
    pageGroup?: string;
    pageType?: string;
    pageTemplate?: string;
  };
}

const {
  title,
  description,
  canonicalUrl = `${business.siteUrl}${Astro.url.pathname}`,
  preloadImages = [],
  ogImage = business.socialImage,
  ogType = "website",
  article,
  noindex = false,
  structuredData,
  analytics,
} = Astro.props;

const fullOgImage = ogImage.startsWith("http") ? ogImage : `${business.siteUrl}${ogImage}`;
const gaId = import.meta.env.PUBLIC_GA_ID;
const googleAdsId = import.meta.env.PUBLIC_GOOGLE_ADS_ID;
const primaryGoogleTagId = gaId || googleAdsId;
const googleAdsQuoteLabel = import.meta.env.PUBLIC_GOOGLE_ADS_QUOTE_LABEL;
const googleAdsPhoneLabel = import.meta.env.PUBLIC_GOOGLE_ADS_PHONE_LABEL;
const googleAdsSmsLabel = import.meta.env.PUBLIC_GOOGLE_ADS_SMS_LABEL;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const turnstileEnabled = Boolean(turnstileSiteKey);

const inferAnalyticsContext = (pathname: string) => {
  if (/^\/services\/[^/]+\/[^/]+\/?$/.test(pathname)) {
    return {
      pageGroup: "service_location_pages",
      pageType: "service_location",
      pageTemplate: "service-location",
    };
  }

  if (pathname === "/services-by-area" || pathname === "/services-by-area/") {
    return {
      pageGroup: "service_location_pages",
      pageType: "service_location_hub",
      pageTemplate: "service-location-hub",
    };
  }

  if (/^\/services\/[^/]+\/?$/.test(pathname)) {
    return {
      pageGroup: "service_pages",
      pageType: "service_detail",
      pageTemplate: "service-detail",
    };
  }

  if (/^\/areas\/[^/]+\/?$/.test(pathname)) {
    return {
      pageGroup: "area_pages",
      pageType: "area_detail",
      pageTemplate: "area-detail",
    };
  }

  if (pathname === "/services" || pathname === "/services/") {
    return {
      pageGroup: "service_pages",
      pageType: "service_index",
      pageTemplate: "service-index",
    };
  }

  if (pathname === "/service-area" || pathname === "/service-area/") {
    return {
      pageGroup: "area_pages",
      pageType: "area_index",
      pageTemplate: "area-index",
    };
  }

  if (pathname === "/blog" || pathname === "/blog/") {
    return {
      pageGroup: "blog",
      pageType: "blog_index",
      pageTemplate: "blog-index",
    };
  }

  if (/^\/blog\/[^/]+\/?$/.test(pathname)) {
    return {
      pageGroup: "blog",
      pageType: "blog_article",
      pageTemplate: "blog-article",
    };
  }

  if (pathname === "/" || pathname === "") {
    return {
      pageGroup: "homepage",
      pageType: "home",
      pageTemplate: "home",
    };
  }

  return {
    pageGroup: "site",
    pageType: "default",
    pageTemplate: "default",
  };
};

const inferredAnalyticsContext = inferAnalyticsContext(Astro.url.pathname);

const analyticsContext = {
  pageGroup: analytics?.pageGroup ?? inferredAnalyticsContext.pageGroup,
  pageType: analytics?.pageType ?? inferredAnalyticsContext.pageType,
  pageTemplate: analytics?.pageTemplate ?? inferredAnalyticsContext.pageTemplate,
};

const structuredDataArray = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
const shouldAutoLoadGoogleAds = analyticsContext.pageTemplate !== "home";
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<meta
  name="robots"
  content={noindex
    ? "noindex, follow"
    : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
/>
<link rel="canonical" href={canonicalUrl} />

{
  preloadImages.map((image) => (
    <link
      rel="preload"
      as="image"
      href={image.href}
      type={image.type}
      media={image.media}
      imagesrcset={image.srcSet}
      imagesizes={image.sizes}
      fetchpriority={image.fetchPriority}
    />
  ))
}

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={fullOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${business.name} landscaping services`} />
<meta property="og:locale" content="en_CA" />
<meta property="og:site_name" content={business.name} />

{
  article && (
    <>
      <meta property="article:published_time" content={article.publishedTime} />
      {article.modifiedTime && (
        <meta property="article:modified_time" content={article.modifiedTime} />
      )}
      <meta property="article:author" content={article.author} />
      {article.tags?.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullOgImage} />
<meta name="twitter:image:alt" content={`${business.name} landscaping services`} />

<!-- Theme & Geo -->
<meta name="theme-color" content="#161616" />
<meta name="geo.region" content="CA-BC" />
<meta name="geo.placename" content={`${business.address.locality}, Victoria`} />
<meta name="geo.position" content={`${business.geo.latitude};${business.geo.longitude}`} />
<meta name="ICBM" content={`${business.geo.latitude}, ${business.geo.longitude}`} />

<!-- Favicons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png?v=2" />
<link rel="icon" href="/favicon.ico?v=2" />
<link rel="apple-touch-icon" href="/favicon.png?v=2" />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Manrope:wght@300;400;500;600&display=swap"
  rel="preload"
  as="style"
  onload="this.onload=null;this.rel='stylesheet'"
/>
<noscript>
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Manrope:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />
</noscript>

<!-- Google Analytics -->
{
  primaryGoogleTagId && (
    <>
      <script
        is:inline
      define:vars={{
        gaId,
        googleAdsId,
        primaryGoogleTagId,
        googleAdsQuoteLabel,
        googleAdsPhoneLabel,
        googleAdsSmsLabel,
        analyticsContext,
        shouldAutoLoadGoogleAds,
      }}
      >
        window.dataLayer = window.dataLayer || [];
        window.gtag = function gtag() {
          dataLayer.push(arguments);
        };

        var gaLoaded = false;
        var googleAdsLoaded = false;
        var loadAnalytics = function () {
          if (gaLoaded) return;
          gaLoaded = true;
          var script = document.createElement("script");
          script.async = true;
          script.src = "https://www.googletagmanager.com/gtag/js?id=" + primaryGoogleTagId;
          document.head.appendChild(script);
        };
        var loadGoogleAds = function () {
          if (!googleAdsId || googleAdsLoaded) return;
          googleAdsLoaded = true;
          gtag("config", googleAdsId);
          var script = document.createElement("script");
          script.async = true;
          script.src = "https://www.googletagmanager.com/gtag/js?id=" + googleAdsId;
          document.head.appendChild(script);
        };

        var scheduleAnalytics = function () {
          if ("requestIdleCallback" in window) {
            window.requestIdleCallback(loadAnalytics, { timeout: 2500 });
          } else {
            window.setTimeout(loadAnalytics, 1800);
          }
        };

        window.addEventListener("load", scheduleAnalytics, { once: true });
        ["pointerdown", "keydown", "touchstart", "scroll"].forEach(function (eventName) {
          window.addEventListener(eventName, loadAnalytics, { once: true, passive: true });
        });
        window.__MS_LOAD_GOOGLE_ADS = loadGoogleAds;

        gtag("js", new Date());
        window.__MS_ANALYTICS_CONTEXT__ = analyticsContext;
        window.__MS_GOOGLE_ADS_CONVERSIONS__ = {
          quote: googleAdsQuoteLabel || "",
          phone: googleAdsPhoneLabel || "",
          sms: googleAdsSmsLabel || "",
        };
        if (gaId) {
          gtag("config", gaId, {
            anonymize_ip: true,
            send_page_view: false,
          });
        }
        if (googleAdsId && shouldAutoLoadGoogleAds) {
          loadGoogleAds();
        }
        gtag("event", "page_view", {
          page_title: document.title,
          page_location: window.location.href,
          page_path: window.location.pathname,
          page_group: analyticsContext.pageGroup,
          page_type: analyticsContext.pageType,
          page_template: analyticsContext.pageTemplate,
        });
      </script>
    </>
  )
}

<script is:inline define:vars={{ analyticsContext }}>
  (function () {
    var storageKey = "ms_attribution_v1";
    var queryKeys = [
      "utm_source",
      "utm_medium",
      "utm_campaign",
      "utm_content",
      "utm_term",
      "gclid",
      "fbclid",
      "msclkid",
    ];

    var readStored = function () {
      try {
        var raw = window.localStorage.getItem(storageKey);
        if (!raw) return {};
        var parsed = JSON.parse(raw);
        return parsed && typeof parsed === "object" ? parsed : {};
      } catch {
        return {};
      }
    };

    var writeStored = function (value) {
      try {
        window.localStorage.setItem(storageKey, JSON.stringify(value));
      } catch {
        // Ignore storage errors in private mode.
      }
    };

    var params = new URLSearchParams(window.location.search);
    var queryAttribution = {};
    var hasQueryAttribution = false;

    queryKeys.forEach(function (key) {
      var value = params.get(key);
      if (!value) return;
      queryAttribution[key] = value.slice(0, 120);
      hasQueryAttribution = true;
    });

    var storedAttribution = readStored();
    var attribution = Object.assign({}, storedAttribution, queryAttribution);

    if (!attribution.landing_page) {
      attribution.landing_page = window.location.pathname;
    }
    if (!attribution.referrer && document.referrer) {
      attribution.referrer = document.referrer.slice(0, 400);
    }

    if (hasQueryAttribution) {
      attribution.landing_page = (window.location.pathname + window.location.search).slice(0, 300);
      if (document.referrer) {
        attribution.referrer = document.referrer.slice(0, 400);
      }
      writeStored(attribution);
    }

    window.__MS_ATTRIBUTION__ = attribution;

    var hasCampaignData = Boolean(
      attribution.utm_source ||
        attribution.utm_medium ||
        attribution.utm_campaign ||
        attribution.gclid ||
        attribution.fbclid ||
        attribution.msclkid
    );

    if (window.gtag && hasCampaignData) {
      var dedupeKey = "ms_campaign_landing:" + window.location.pathname + window.location.search;
      if (!window.sessionStorage.getItem(dedupeKey)) {
        window.gtag("event", "campaign_landing", {
          page_group: analyticsContext.pageGroup || "site",
          page_type: analyticsContext.pageType || "default",
          page_template: analyticsContext.pageTemplate || "default",
          utm_source: attribution.utm_source || "(not set)",
          utm_medium: attribution.utm_medium || "(not set)",
          utm_campaign: attribution.utm_campaign || "(not set)",
          utm_content: attribution.utm_content || "(not set)",
          utm_term: attribution.utm_term || "(not set)",
          gclid: attribution.gclid || "",
          fbclid: attribution.fbclid || "",
          msclkid: attribution.msclkid || "",
        });
        window.sessionStorage.setItem(dedupeKey, "1");
      }
    }
  })();
</script>

<!-- Cloudflare Turnstile -->
{
  turnstileEnabled && (
    <script
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
      is:inline
    />
  )
}

<!-- Structured Data -->
{
  structuredDataArray.length > 0 && (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(
        structuredDataArray.length === 1 ? structuredDataArray[0] : structuredDataArray
      )}
    />
  )
}
