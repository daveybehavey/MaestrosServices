---
import { propertyResetExamples } from "../data/proof";

interface Props {
  heading?: string;
  eyebrow?: string;
  intro?: string;
  limit?: number;
}

const {
  eyebrow = "Property reset examples",
  heading = "Proof-style scopes that do not need public photos.",
  intro = "These examples show common homeowner situations and the kind of practical result we aim to create, without exposing private property details.",
  limit = propertyResetExamples.length,
} = Astro.props;

const examples = propertyResetExamples.slice(0, limit);
---

<section class="section">
  <div class="mx-auto max-w-6xl px-5 sm:px-6">
    <div class="mb-8 grid gap-5 lg:grid-cols-[0.9fr_1.1fr] lg:items-end">
      <div class="space-y-3">
        <p class="section-kicker">{eyebrow}</p>
        <h2 class="section-title">{heading}</h2>
      </div>
      <p class="section-copy max-w-2xl lg:justify-self-end">{intro}</p>
    </div>

    <div class="grid gap-5 lg:grid-cols-2">
      {
        examples.map((example, index) => (
          <article
            class="lift-card p-6 animate-rise sm:p-7"
            style={`animation-delay: ${index * 70}ms`}
          >
            <div class="mb-5 flex flex-wrap items-center gap-2 text-[0.66rem] uppercase tracking-[0.22em] text-ink-soft">
              <span class="rounded-full border border-border bg-paper px-3 py-1">
                {example.area}
              </span>
              <span class="rounded-full border border-border bg-white px-3 py-1">
                {example.serviceType}
              </span>
            </div>

            <div class="grid gap-4 sm:grid-cols-[0.88fr_1.12fr]">
              <div class="rounded-2xl border border-border bg-paper/70 p-4">
                <p class="text-xs uppercase tracking-[0.22em] text-ink-soft">Situation</p>
                <p class="mt-2 text-sm text-ink-soft">{example.situation}</p>
                <p class="mt-4 text-xs uppercase tracking-[0.22em] text-ink-soft">Best for</p>
                <p class="mt-2 text-sm font-semibold text-ink">{example.bestFor}</p>
              </div>

              <div>
                <p class="text-xs uppercase tracking-[0.22em] text-ink-soft">Work completed</p>
                <ul class="mt-3 space-y-2 text-sm text-ink-soft">
                  {example.workCompleted.map((item) => (
                    <li class="flex gap-3">
                      <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-ink/70" />
                      {item}
                    </li>
                  ))}
                </ul>
                <div class="mt-5 rounded-2xl border border-ink/10 bg-white/80 p-4">
                  <p class="text-xs uppercase tracking-[0.22em] text-ink-soft">Outcome</p>
                  <p class="mt-2 text-sm font-semibold text-ink">{example.outcome}</p>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
