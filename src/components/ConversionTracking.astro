---
const gaId = import.meta.env.PUBLIC_GA_ID;
---

{
  gaId && (
    <script is:inline>
      (function () {
        if (!window.gtag) return;

        var analyticsContext = window.__MS_ANALYTICS_CONTEXT__ || {};
        var context = function () {
          return {
            page_group: analyticsContext.pageGroup || "site",
            page_type: analyticsContext.pageType || "default",
            page_template: analyticsContext.pageTemplate || "default",
          };
        };

        var send = function (eventName, params) {
          window.gtag("event", eventName, Object.assign(context(), params || {}));
        };

        document.addEventListener("click", function (event) {
          var target = event.target;
          if (!(target instanceof Element)) return;

          var tracked = target.closest("[data-ga-event]");
          if (tracked) {
            send(tracked.getAttribute("data-ga-event"), {
              event_category: "cta",
              event_label: tracked.getAttribute("data-ga-label") || "",
            });
          }

          var link = target.closest("a[href]");
          if (!link) return;

          var href = link.getAttribute("href") || "";
          if (href.indexOf("tel:") === 0) {
            send("phone_click", {
              event_category: "lead",
              event_label: link.getAttribute("data-ga-label") || "phone_link",
            });
          } else if (href.indexOf("sms:") === 0) {
            send("sms_click", {
              event_category: "lead",
              event_label: link.getAttribute("data-ga-label") || "sms_link",
            });
          } else if (href.indexOf("mailto:") === 0) {
            send("email_click", {
              event_category: "lead",
              event_label: link.getAttribute("data-ga-label") || "email_link",
            });
          }
        });

        var quoteForm = document.getElementById("quote-form");
        if (quoteForm) {
          var quoteStarted = false;
          quoteForm.addEventListener(
            "focusin",
            function () {
              if (quoteStarted) return;
              quoteStarted = true;
              send("quote_form_start", {
                event_category: "form",
                event_label: "quote_form",
              });
            },
            { passive: true }
          );

          if ("IntersectionObserver" in window) {
            var formViewKey = "ms_quote_form_view:" + window.location.pathname;
            var observer = new IntersectionObserver(
              function (entries) {
                if (!entries[0] || !entries[0].isIntersecting) return;
                if (!window.sessionStorage.getItem(formViewKey)) {
                  send("quote_form_view", {
                    event_category: "form",
                    event_label: "quote_form",
                  });
                  window.sessionStorage.setItem(formViewKey, "1");
                }
                observer.disconnect();
              },
              { threshold: 0.35 }
            );
            observer.observe(quoteForm);
          }
        }
      })();
    </script>
  )
}
