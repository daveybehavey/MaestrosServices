---
import { business } from "../data/business";

interface Props {
  preselectedService?: string;
  preselectedArea?: string;
  showInfoBox?: boolean;
  returnTo?: string;
}

const {
  preselectedService,
  preselectedArea,
  showInfoBox = true,
  returnTo = `${Astro.url.pathname}#quote`,
} = Astro.props;

const submitted = Astro.url.searchParams.get("submitted");
const error = Astro.url.searchParams.get("error");
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const turnstileEnabled = Boolean(turnstileSiteKey);
const showSuccessState = submitted === "1";
const showErrorState = error === "1";
---

<div class="grid gap-10 lg:grid-cols-[0.92fr_1.08fr]">
  {
    showInfoBox && (
      <div class="surface-card relative overflow-hidden p-6 sm:p-8">
        <div class="absolute -right-10 -top-10 h-36 w-36 rounded-full bg-sage/25"></div>
        <div class="relative space-y-4">
        <p class="section-kicker">Get a free quote</p>
        <h2 class="section-title">Tell us the job, area, and timing.</h2>
        <p class="text-sm text-ink-soft">
          Fill out the form and we usually reply within 1 hour during work hours. If it is a fit,
          we will confirm the practical next step, timing, and quote approach. For the fastest
          quote, call or text {business.phone} first.
        </p>
        <p class="text-xs uppercase tracking-[0.25em] text-ink-soft">No obligation. Takes about 30 seconds.</p>
        <div class="rounded-2xl border border-border bg-paper/70 p-6 text-sm text-ink-soft">
          <p class="font-semibold text-ink">Book-now offers this week</p>
          <ul class="mt-2 space-y-1">
            <li>- Fence Refresh and Minor Repair</li>
            <li>- Rock Work Refresh</li>
            <li>- Power Wash Reset</li>
            <li>- Mulch Refresh</li>
          </ul>
        </div>
        <div class="rounded-2xl border border-border bg-white/90 p-6 text-sm text-ink-soft">
          <p class="font-semibold text-ink">What happens after you submit</p>
          <ul class="mt-2 space-y-1">
            <li>- We review the job details and area</li>
            <li>- We reply by your preferred contact method</li>
            <li>- We let you know if photos or a quick call will speed things up</li>
          </ul>
          <a
            class="mt-3 inline-flex rounded-full border border-ink/15 px-4 py-2 font-semibold text-ink hover:border-ink"
            href={business.smsHref}
            data-ga-event="cta_click"
            data-ga-label="quote_form_info_text_photos"
          >
            Text photos for a quote
          </a>
          <p class="mt-4 font-semibold text-ink">Prefer email?</p>
          <p>We can reply there too, but text or call is usually faster for same-day movement.</p>
          <a
            class="mt-1 inline-block underline decoration-ink/30"
            href={`mailto:${business.email}`}
          >
            {business.email}
          </a>
        </div>
        </div>
      </div>
    )
  }

  <form
    id="quote-form"
    class="surface-card space-y-4 p-6 sm:p-8"
    method="POST"
    action="/api/quote"
  >
    {
      showSuccessState && (
        <div
          id="quote-success"
          class="rounded-[1.4rem] border border-ink/15 bg-white px-5 py-5 text-ink shadow-fine"
          tabindex="-1"
          role="status"
          aria-live="polite"
        >
          <p class="text-xs uppercase tracking-[0.22em] text-ink-soft">Quote request received</p>
          <h3 class="mt-2 text-2xl font-display font-semibold text-ink sm:text-[2rem]">
            Thanks, your quote request is in.
          </h3>
          <p class="mt-2 text-sm text-ink-soft">
            We have your details and usually reply within 1 hour during work hours. If you want
            the fastest follow-up, send photos by text and mention the area plus the service you
            need.
          </p>
          <div class="mt-4 flex flex-wrap gap-2 text-[0.68rem] uppercase tracking-[0.2em] text-ink-soft">
            <span class="rounded-full border border-border bg-paper px-3 py-1.5">Request received</span>
            <span class="rounded-full border border-border bg-paper px-3 py-1.5">Reply within 1 hour</span>
            <span class="rounded-full border border-border bg-paper px-3 py-1.5">Text photos anytime</span>
          </div>
          <div class="mt-4 flex flex-col gap-3 sm:flex-row">
            <a
              class="btn-primary px-5 py-3 text-center"
              href={business.smsHref}
              data-ga-event="cta_click"
              data-ga-label="quote_success_text_photos"
            >
              Text photos for a faster quote
            </a>
            <a
              class="btn-secondary px-5 py-3 text-center"
              href={`tel:${business.phoneTel}`}
              data-ga-event="cta_click"
              data-ga-label="quote_success_call_now"
            >
              Call {business.phone}
            </a>
          </div>
          <p class="mt-4 text-xs text-ink-soft">
            No need to resubmit unless something important changed.
          </p>
        </div>
      )
    }
    {
      showErrorState && (
        <div class="rounded-xl border border-ink/30 bg-white/90 px-4 py-3 text-sm text-ink" role="alert">
          Something went wrong. Please try again or call/text {business.phone}.
        </div>
      )
    }
    <p class="text-xs uppercase tracking-[0.22em] text-ink-soft">Takes about 30 seconds</p>
    <div class="flex flex-wrap gap-2 text-[0.62rem] uppercase tracking-[0.22em] text-ink-soft">
      <span class="rounded-full border border-border bg-paper px-3 py-1">Owner-operated</span>
      <span class="rounded-full border border-border bg-paper px-3 py-1">Residential service</span>
      <span class="rounded-full border border-border bg-paper px-3 py-1">Reply within 1 hour</span>
    </div>

    <div>
      <label class="text-sm font-semibold" for="name">Name</label>
      <input
        class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-sm focus:border-ink/40 focus:outline-none focus:ring-2 focus:ring-ink/10"
        id="name"
        name="name"
        autocomplete="name"
        placeholder="Your name"
        required
      />
    </div>

    <div>
      <label class="text-sm font-semibold" for="phone">Phone</label>
      <input
        class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-sm focus:border-ink/40 focus:outline-none focus:ring-2 focus:ring-ink/10"
        id="phone"
        name="phone"
        type="tel"
        inputmode="tel"
        autocomplete="tel"
        placeholder="(250) 858-1781"
        required
      />
    </div>

    <div>
      <label class="text-sm font-semibold" for="email">Email (optional)</label>
      <input
        class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-sm focus:border-ink/40 focus:outline-none focus:ring-2 focus:ring-ink/10"
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        placeholder="you@email.com"
      />
    </div>

    <div>
      <label class="text-sm font-semibold" for="area">Service area</label>
      <input
        class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-sm focus:border-ink/40 focus:outline-none focus:ring-2 focus:ring-ink/10"
        id="area"
        name="area"
        autocomplete="address-level2"
        placeholder="Town or neighborhood"
        value={preselectedArea || ""}
        required
      />
    </div>

    <div>
      <label class="text-sm font-semibold" for="service">Primary service needed</label>
      <select
        class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-sm focus:border-ink/40 focus:outline-none focus:ring-2 focus:ring-ink/10"
        id="service"
        name="service"
        required
      >
        <option value="not-sure" selected={!preselectedService}>Not sure yet (we can recommend)</option>
        <option value="mowing" selected={preselectedService === "mowing"}>
          Mowing and edging
        </option>
        <option value="trim" selected={preselectedService === "trim"}>
          Trimming and pruning
        </option>
        <option value="cleanup" selected={preselectedService === "cleanup"}>
          Seasonal cleanup
        </option>
        <option value="mulch" selected={preselectedService === "mulch"}>
          Mulching and garden beds
        </option>
        <option value="powerwash" selected={preselectedService === "powerwash"}>
          Power washing (driveway, patio, exterior)
        </option>
        <option value="rock" selected={preselectedService === "rock"}>
          Rock work / rock walls
        </option>
        <option value="fence" selected={preselectedService === "fence"}>
          Fence work / minor repairs
        </option>
        <option value="gutter" selected={preselectedService === "gutter"}>
          Gutter cleaning (ground-accessible)
        </option>
        <option value="pruning" selected={preselectedService === "pruning"}>
          Light pruning and shape-up
        </option>
        <option value="moss" selected={preselectedService === "moss"}>
          Moss/algae treatment
        </option>
        <option value="driveway" selected={preselectedService === "driveway"}>
          Driveway grading or repair
        </option>
        <option value="gravel" selected={preselectedService === "gravel"}>
          Gravel driveway install/refresh
        </option>
        <option value="ongoing" selected={preselectedService === "ongoing"}>
          Ongoing maintenance
        </option>
        <option value="other" selected={preselectedService === "other"}>
          Other (describe below)
        </option>
      </select>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="text-sm font-semibold" for="timeline">When would you like this done?</label>
        <select
          class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-sm focus:border-ink/40 focus:outline-none focus:ring-2 focus:ring-ink/10"
          id="timeline"
          name="timeline"
        >
          <option value="">Not sure yet</option>
          <option value="as-soon-as-possible">As soon as possible</option>
          <option value="this-week">This week</option>
          <option value="next-1-2-weeks">Next 1-2 weeks</option>
          <option value="flexible">Flexible timing</option>
        </select>
      </div>

      <div>
        <label class="text-sm font-semibold" for="preferred-contact">Best way to reply</label>
        <select
          class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-sm focus:border-ink/40 focus:outline-none focus:ring-2 focus:ring-ink/10"
          id="preferred-contact"
          name="preferred_contact"
        >
          <option value="text">Text first</option>
          <option value="call">Call first</option>
          <option value="email">Email if provided</option>
          <option value="any">Any method is fine</option>
        </select>
      </div>
    </div>

    <div>
      <label class="text-sm font-semibold" for="details">Details (optional)</label>
      <textarea
        class="mt-2 min-h-[96px] w-full rounded-xl border border-ink/15 bg-white px-4 py-3 text-sm focus:border-ink/40 focus:outline-none focus:ring-2 focus:ring-ink/10 sm:min-h-[120px]"
        id="details"
        name="details"
        placeholder="Tell us about your yard, access, and timing."></textarea>
    </div>

    <div class="rounded-xl border border-border bg-paper/70 p-4 text-sm text-ink-soft">
      <p class="font-semibold text-ink">What to send for a fast quote</p>
      <ul class="mt-2 space-y-1">
        <li>- Your area or neighborhood</li>
        <li>- Service needed (fence, rock work, mulch, power wash, cleanup, or other)</li>
        <li>- Preferred timing (this week, next week, or flexible)</li>
        <li>- Photos if the area is hard to describe</li>
      </ul>
    </div>

    <!-- Honeypot -->
    <input type="hidden" name="return_to" value={returnTo} />
    <input type="hidden" id="utm-source" name="utm_source" value="" />
    <input type="hidden" id="utm-medium" name="utm_medium" value="" />
    <input type="hidden" id="utm-campaign" name="utm_campaign" value="" />
    <input type="hidden" id="utm-content" name="utm_content" value="" />
    <input type="hidden" id="utm-term" name="utm_term" value="" />
    <input type="hidden" id="gclid" name="gclid" value="" />
    <input type="hidden" id="fbclid" name="fbclid" value="" />
    <input type="hidden" id="msclkid" name="msclkid" value="" />
    <input type="hidden" id="landing-page" name="landing_page" value="" />
    <input type="hidden" id="referrer" name="referrer" value="" />
    <input type="hidden" id="page-title" name="page_title" value="" />
    <input type="hidden" id="page-path" name="page_path" value="" />

    <div class="hidden" aria-hidden="true">
      <label class="text-sm font-semibold" for="company">Company</label>
      <input id="company" name="company" tabindex="-1" autocomplete="off" />
    </div>
    <div class="hidden" aria-hidden="true">
      <label class="text-sm font-semibold" for="website">Website</label>
      <input id="website" name="website" tabindex="-1" autocomplete="off" />
    </div>
    <input id="form-started-at" type="hidden" name="form_started_at" value="" />

    {
      turnstileEnabled && (
        <div class="mt-2">
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-action="quote_form" />
        </div>
      )
    }

    <button
      class="btn-primary w-full px-6 py-3"
      type="submit"
    >
      Get my free quote
    </button>

    <p class="text-xs text-ink-soft">
      By submitting, you agree to be contacted by phone, text, or email about your request. No spam.
    </p>
  </form>
</div>

<script is:inline>
  (function () {
    var quoteForm = document.getElementById("quote-form");
    var successPanel = document.getElementById("quote-success");
    var startedAtInput = document.getElementById("form-started-at");
    var submitButton = quoteForm ? quoteForm.querySelector('button[type="submit"]') : null;
    var localStorageKey = "ms_attribution_v1";

    var readStoredAttribution = function () {
      try {
        var raw = window.localStorage.getItem(localStorageKey);
        if (!raw) return {};
        var parsed = JSON.parse(raw);
        return parsed && typeof parsed === "object" ? parsed : {};
      } catch {
        return {};
      }
    };

    var attribution = Object.assign(
      {},
      readStoredAttribution(),
      window.__MS_ATTRIBUTION__ || {}
    );

    var attributionFieldByKey = {
      utm_source: "utm-source",
      utm_medium: "utm-medium",
      utm_campaign: "utm-campaign",
      utm_content: "utm-content",
      utm_term: "utm-term",
      gclid: "gclid",
      fbclid: "fbclid",
      msclkid: "msclkid",
      landing_page: "landing-page",
      referrer: "referrer",
    };

    Object.keys(attributionFieldByKey).forEach(function (key) {
      var input = document.getElementById(attributionFieldByKey[key]);
      if (!input) return;
      var value = attribution[key];
      if (!value) return;
      input.value = String(value).slice(0, 400);
    });

    var landingPageInput = document.getElementById("landing-page");
    if (landingPageInput && !landingPageInput.value) {
      landingPageInput.value = (window.location.pathname + window.location.search).slice(0, 300);
    }

    var referrerInput = document.getElementById("referrer");
    if (referrerInput && !referrerInput.value && document.referrer) {
      referrerInput.value = document.referrer.slice(0, 400);
    }

    var pageTitleInput = document.getElementById("page-title");
    if (pageTitleInput) {
      pageTitleInput.value = document.title.slice(0, 180);
    }

    var pagePathInput = document.getElementById("page-path");
    if (pagePathInput) {
      pagePathInput.value = (window.location.pathname + window.location.search).slice(0, 300);
    }

    if (startedAtInput) {
      startedAtInput.value = String(Date.now());
    }
    if (window.gtag) {
      var analyticsContext = window.__MS_ANALYTICS_CONTEXT__ || {};
      var urlParams = new URLSearchParams(window.location.search);
      var submittedStatus = urlParams.get("submitted");
      var errorStatus = urlParams.get("error");
      var leadEventId = urlParams.get("lead_event_id");
      var successEventKey = "ms_quote_success:" + (leadEventId || (window.location.pathname + window.location.search));
      var errorEventKey = "ms_quote_error:" + window.location.pathname + window.location.search;
      var sendLeadSuccess = function (eventId) {
        var eventKey = "ms_quote_success:" + (eventId || (window.location.pathname + window.location.search));
        if (window.sessionStorage.getItem(eventKey)) return;
        window.gtag("event", "generate_lead", {
          event_category: "form",
          event_label: "quote_form_success",
          lead_event_id: eventId || "(not set)",
          page_group: analyticsContext.pageGroup || "site",
          page_type: analyticsContext.pageType || "default",
          page_template: analyticsContext.pageTemplate || "default",
          utm_source: attribution.utm_source || "(not set)",
          utm_medium: attribution.utm_medium || "(not set)",
          utm_campaign: attribution.utm_campaign || "(not set)",
        });
        window.sessionStorage.setItem(eventKey, "1");
      };

      if (submittedStatus === "1" && !window.sessionStorage.getItem(successEventKey)) {
        sendLeadSuccess(leadEventId);
      }

      if (submittedStatus === "1" && successPanel) {
        window.requestAnimationFrame(function () {
          successPanel.scrollIntoView({ behavior: "smooth", block: "center" });
          successPanel.focus({ preventScroll: true });
        });
      }

      if (errorStatus === "1" && !window.sessionStorage.getItem(errorEventKey)) {
        window.gtag("event", "form_submit_error", {
          event_category: "form",
          event_label: "quote_form_error",
          page_group: analyticsContext.pageGroup || "site",
          page_type: analyticsContext.pageType || "default",
          page_template: analyticsContext.pageTemplate || "default",
        });
        window.sessionStorage.setItem(errorEventKey, "1");
      }

      if (quoteForm) {
        quoteForm.addEventListener("submit", function (event) {
          if (!window.fetch || !window.FormData) return;

          event.preventDefault();

          if (submitButton instanceof HTMLButtonElement) {
            submitButton.disabled = true;
            submitButton.textContent = "Sending...";
          }

          var restoreButton = function () {
            if (!(submitButton instanceof HTMLButtonElement)) return;
            submitButton.disabled = false;
            submitButton.textContent = "Get my free quote";
          };

          var formData = new FormData(quoteForm);

          window.gtag("event", "form_submit", {
            event_category: "form",
            event_label: "quote_form",
            page_group: analyticsContext.pageGroup || "site",
            page_type: analyticsContext.pageType || "default",
            page_template: analyticsContext.pageTemplate || "default",
          });

          fetch(quoteForm.action, {
            method: "POST",
            body: formData,
            credentials: "same-origin",
            redirect: "follow",
          })
            .then(function (response) {
              var nextUrl = response.url || quoteForm.action;
              var nextParams = new URL(nextUrl, window.location.origin).searchParams;
              if (nextParams.get("submitted") === "1") {
                sendLeadSuccess(nextParams.get("lead_event_id"));
              } else if (
                nextParams.get("error") === "1" &&
                !window.sessionStorage.getItem(errorEventKey)
              ) {
                window.gtag("event", "form_submit_error", {
                  event_category: "form",
                  event_label: "quote_form_error",
                  page_group: analyticsContext.pageGroup || "site",
                  page_type: analyticsContext.pageType || "default",
                  page_template: analyticsContext.pageTemplate || "default",
                });
                window.sessionStorage.setItem(errorEventKey, "1");
              }
              window.location.assign(nextUrl);
            })
            .catch(function () {
              restoreButton();
              quoteForm.submit();
            });
        });

        quoteForm.addEventListener("submit", function () {
          // Native submit fallback when JS interception is unavailable.
        });
      }
    }
  })();
</script>
