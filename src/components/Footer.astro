---
import { business } from "../data/business";

interface Props {
  includeMobilePadding?: boolean;
}

const { includeMobilePadding = true } = Astro.props;
const profileLabels: Record<string, string> = {
  "www.facebook.com": "Facebook",
  "x.com": "X (Twitter)",
  "www.google.com": "Google Business Profile",
  "www.bark.com": "Bark",
};
const profiles = business.sameAs.map((url) => ({
  url,
  host: new URL(url).hostname,
  label: profileLabels[new URL(url).hostname],
})).filter((profile) => profile.label);
---

<footer
  class:list={[
    "border-t border-border/70 bg-paper/80",
    includeMobilePadding && "pb-24 md:pb-0",
  ]}
>
  <div
    class="mx-auto grid max-w-6xl gap-8 px-5 py-8 text-sm text-ink-soft sm:grid-cols-2 sm:px-6 sm:py-10 lg:grid-cols-[1.4fr_0.7fr_1.2fr_0.9fr]"
  >
    <div class="flex items-start gap-3">
      <div
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-ink/15 bg-white/90"
      >
        <img
          src="/logo.webp?v=1"
          alt={`${business.name} logo`}
          class="h-6 w-6"
          width="24"
          height="24"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="space-y-1">
        <p class="text-base font-semibold text-ink">{business.name}</p>
        <p>Property maintenance & landscaping across lower-mid Vancouver Island.</p>
      </div>
    </div>
    <div class="space-y-2">
      <p class="font-semibold text-ink">Explore</p>
      <a
        class="block hover:text-ink"
        href="/services/gutter-cleaning/"
        data-ga-event="cta_click"
        data-ga-label="footer_nav_gutter_cleaning"
      >
        Gutter Cleaning
      </a>
      <a
        class="block hover:text-ink"
        href="/services"
        data-ga-event="cta_click"
        data-ga-label="footer_nav_services"
      >
        Services
      </a>
      <a
        class="block hover:text-ink"
        href="/projects"
        data-ga-event="cta_click"
        data-ga-label="footer_nav_projects"
      >
        Projects
      </a>
      <a
        class="block hover:text-ink"
        href="/blog"
        data-ga-event="cta_click"
        data-ga-label="footer_nav_blog"
      >
        Blog
      </a>
      <a
        class="block hover:text-ink"
        href="/driveway-faq"
        data-ga-event="cta_click"
        data-ga-label="footer_nav_driveway_faq"
      >
        Driveway FAQ
      </a>
      <a
        class="block hover:text-ink"
        href="/service-area"
        data-ga-event="cta_click"
        data-ga-label="footer_nav_service_area"
      >
        Service Area
      </a>
      <a
        class="block hover:text-ink"
        href="/review"
        data-ga-event="cta_click"
        data-ga-label="footer_nav_review"
      >
        Leave a Review
      </a>
    </div>
    <div class="space-y-2">
      <p class="font-semibold text-ink">Contact</p>
      <a
        class="block hover:text-ink"
        href={`tel:${business.phoneTel}`}
        data-ga-event="cta_click"
        data-ga-label="footer_contact_call"
      >
        {business.phone}
      </a>
      <a
        class="block hover:text-ink"
        href={`mailto:${business.email}`}
        data-ga-event="cta_click"
        data-ga-label="footer_contact_email"
      >
        {business.email}
      </a>
      <p>Hours: {business.hoursLabel}</p>
      <a
        class="block hover:text-ink"
        href="/quote"
        data-ga-event="cta_click"
        data-ga-label="footer_contact_quote"
      >
        Get a free quote
      </a>
    </div>
    <nav aria-label="Social and business profiles" class="space-y-2">
      <p class="font-semibold text-ink">Find us online</p>
      {
        profiles.map(({ url, label, host }) => (
          <a
            class="group flex min-h-9 items-center gap-2 rounded-sm hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4"
            href={url}
            target="_blank"
            rel="noopener noreferrer"
            data-ga-event="cta_click"
            data-ga-label={`footer_profile_${new URL(url).hostname}`}
          >
            <span aria-hidden="true" class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-ink/15 bg-white/80 text-ink-soft transition-colors group-hover:border-ink/40 group-hover:text-ink">
              {host === "www.facebook.com" ? (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" focusable="false">
                  <path d="M14 21v-8h3l.5-4H14V7c0-1.2.4-2 2-2h2V1.4A25 25 0 0 0 15 1c-3 0-5 1.8-5 5v3H7v4h3v8z" />
                </svg>
              ) : host === "x.com" ? (
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" focusable="false">
                  <path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3L12 14.6 5.5 22H2.3l7.4-8.5L2 2h6.5l4.5 6.8L18.9 2ZM17.8 20h1.7L7.5 4H5.7l12.1 16Z" />
                </svg>
              ) : (
                <span class="text-sm font-bold leading-none">{host === "www.google.com" ? "G" : "B"}</span>
              )}
            </span>
            {label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="border-t border-border/70">
    <div class="mx-auto max-w-6xl px-5 py-4 text-xs sm:px-6">
      <a
        class="hover:text-ink"
        href="https://eurodigital.ca/projects/maestrosservices"
        target="_blank"
        rel="noopener noreferrer"
      >
        Website by EuroDigital
      </a>
    </div>
  </div>
</footer>
